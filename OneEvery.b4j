'clear and load a middle section layout 
Sub LoadMiddleLayout(vLayout As String)
	pnlParent.RemoveAllNodes
	If vLayout <> "" Then pnlParent.LoadLayout(vLayout)
End Sub

'clear and load the property bag layout
Sub LoadPropertyBagLayout(vLayout As String)
	pnlProperty.RemoveAllNodes
	If vLayout <> "" Then pnlProperty.LoadLayout(vLayout)
End Sub

Sub etvProject_FileSelected (Property As String, Value As String)
	
End Sub

'prepare the app for publishing
Sub App_PreparePublish
	CLI.AppMap = DBUtils.ReadRecord(CLI.AppSQL,"App","id","1")
	If CLI.AppMap.IsInitialized = False Then
		'save the app details
		CLI.AppJSON = jMash.Map2Json(CLI.AppMap)
		CLI.AppMap = CreateMap("id":1,"properties":CLI.AppJSON)
		DBUtils.AddEditRecord(CLI.AppSQL,"App","id","1",CLI.AppMap)
		CLI.AppMap = DBUtils.ReadRecord(CLI.AppSQL,"App","id","1")
	End If
	'read the properties field
	CLI.AppJSON = CLI.AppMap.GetDefault("properties","")
	CLI.AppMap = jMash.Json2Map(CLI.AppJSON)
	CLI.App_GetDetails	
	'initialize the app and prepare the folders
	CLI.App.Initialize(CLI.AppName,CLI.AppID,CLI.Version)
	CLI.App.Website = CLI.WebSite
	CLI.App.Copyrights = CLI.Copyrights
	CLI.App.Author = CLI.Author
	CLI.App.Email = CLI.Email
	CLI.App.SiteTitle = CLI.SiteTitle
	'build each page
	CLI.AppPath = CLI.App.AppPath
	'copy the resources folder to the path
	File.Copy(File.DirAssets,"resources.zip",CLI.App.wwwpath,"resources.zip")
	'unzip the file
	ac.UnZip(CLI.App.wwwPath,"resources.zip",CLI.App.wwwpath,"unzipweb")
	'remove the file
	File.Delete(CLI.App.wwwpath, "resources.zip")
	'add the project appropriate css and js files
	Dim cssFiles As List = DBUtils.ExecuteMaps(CLI.AppSQL,"select * from cssfiles where Active = 1 order by TabIndex",Null)
	For Each cssmap As Map In cssFiles
		Dim sfile As String = cssmap.GetDefault("file","")
		CLI.App.AddCssFile($"css/${sfile}"$)
		File.Copy(File.DirApp,$"css/${sfile}"$,CLI.App.FullCSSPath,sfile)
	Next
	Dim jsFiles As List = DBUtils.ExecuteMaps(CLI.AppSQL,"select * from JSFiles where Active = 1 order by TabIndex",Null)
	For Each jsmap As Map In jsFiles
		Dim sfile As String = jsmap.GetDefault("file","")
		CLI.App.AddJavaScriptFile(sfile)
		File.Copy(File.DirApp,$"js/${sfile}"$,CLI.App.FullJSPath,sfile)
	Next
	If CLI.UseFontAwesome = "1" Then CLI.App.AddFontAwesome
End Sub

'publish the app
Sub App_Publish
	If App_Check = False Then Return
	App_OpenDB
	App_PreparePublish
	App_Pages
	'open the page
	CLI.App.open
	jMash.InformUser(MainForm,CLI.AppName,"Your distribution website is located on " & CLI.App.wwwPath)
End Sub

'generate the pages for the app
Sub App_Pages
	Dim dbPages As List = DBUtils.ExecuteField1(CLI.AppSQL, "select PageName from pages where Active = 1","pagename",False,False)
	For Each pgName As String In dbPages
		wait for (Page_Build(pgName)) complete(Result As Boolean)
	Next
End Sub

public Sub unzipweb_unzipdone(CompletedWithoutError As Boolean, NbOfFiles As Int)
	Log(CompletedWithoutError)
	Select Case NbOfFiles
	Case -1
		jMash.InformUserError(MainForm,"Resources Error","The web assets for the project COULD NOT be prepared at this time.")
	Case Else
		jMash.InformUser(MainForm,"Resources","The web assets for the project have been prepared and you are now ready to create the pages.")
	End Select
End Sub

'read the app details from the database and disply in the property bag
Sub App_Read
	'read the project details
	CLI.AppMap = DBUtils.ReadRecord(CLI.AppSQL,"App","id","1")
	If CLI.AppMap.IsInitialized = False Then Return
	'read the properties field
	CLI.AppJSON = CLI.AppMap.GetDefault("properties","")
	CLI.AppMap = jMash.Json2Map(CLI.AppJSON)
	jMash.putobject("lastproject",CLI.AppMap)
	CLI.App_GetDetails
	'show the app properties
	App_Initialize
	etvProject.SetPropertyBag(CLI.AppMap)
	'load the pages
	MainForm.Title = "OneEvery: " & CLI.AppName
	CLI.App.Initialize(CLI.AppName,CLI.AppID,CLI.Version)
	jMash.WebViewLoadFile(CLI.App.wwwPath,"index.html",AppView)
	'jMash.ShowHTML(CLI.App.wwwpath,"index.html",txtHTML)
End Sub

'as the user for an app db to open
Sub App_Open
	CLI.AppDB = jMash.OpenSaveFileDialog(MainForm,True,"Open App",File.DirApp & "\Projects",jMash.CreateList(",","*.db"))
	If CLI.AppDB = "" Then Return
	'ensure user has selected a database file
	If CLI.AppDB.ToLowerCase.EndsWith(".db") Then
		TreeClear
		Dim dir As String = File.GetFileParent(CLI.AppDB)
		Dim fil As String = File.GetName(CLI.AppDB)
		CLI.AppSQL.InitializeSQLite(dir,fil,True)
		CLI.AppSQL_Prepare
		'read the project details
		App_Read
	Else
		jMash.MsgBoxWarn(MainForm,"App Database","Please select an SQL db file with a .db extension!")
		Return
	End If
End Sub

'check the app details
Sub App_Check As Boolean
	If etvProject.IsInitialized = False Then Return False
	CLI.AppMap = etvProject.GetPropertyBag
	CLI.App_GetDetails
	'verify if specified
	If jMash.IsBlank1(MainForm,CLI.AppName,"App Name") = True Then Return False
	If jMash.IsBlank1(MainForm,CLI.AppID,"App ID") = True Then Return False
	If jMash.IsBlank1(MainForm,CLI.Version,"Version") = True Then Return False
	Return True
End Sub

'open the appSQL database for this app
Sub App_OpenDB
	CLI.AppMap = etvProject.GetPropertyBag
	CLI.App_GetDetails
	If CLI.AppName = "" Then Return
	'create the necessary folders
	CLI.App.Initialize(CLI.AppName,CLI.AppID,CLI.Version)
	CLI.AppPath = CLI.App.AppPath
	'create the database for OneEvery
	CLI.AppDB = CLI.AppPath & "\" & CLI.AppName & ".db"
	'create it if necessary
	CLI.AppSQL.InitializeSQLite("",CLI.AppDB,True)	
	CLI.AppSQL_Prepare
	File.MakeDir(CLI.AppPath,"Code")
	CLI.CodePath = CLI.AppPath & "\Code"
End Sub



'save the app details, if new create an index page too
Sub App_Save
	If App_Check = False Then Return
	App_OpenDB
	'save the app details
	CLI.AppJSON = jMash.Map2Json(CLI.AppMap)
	Dim rec As Map = CreateMap("id":1,"properties":CLI.AppJSON)
	DBUtils.AddEditRecord(CLI.AppSQL,"App","id","1",rec)
	'do we have an index page
	If DBUtils.RecordExists(CLI.AppSQL,"Pages","PageName","index") = False Then
		Dim index As Map = CreateMap("PageName":"index","HtmlName":"index.html","Active":1,"Title":CLI.AppName,"Description":"Home Page", _
		"TabIndex":1,"Keywords":CLI.AppName & ";index;home")
		DBUtils.AddEditRecord(CLI.AppSQL,"Pages","PageName","index",index)
	End If
	CLI.AppMap = DBUtils.ReadRecord(CLI.AppSQL,"App","id","1")
	CLI.App_GetDetails
	CLI.App.Initialize(CLI.AppName,CLI.AppID,CLI.Version)
	jMash.InformUser(MainForm,CLI.AppName,"App details have been saved.")
End Sub

'reload the contents on tab selection
Sub tabs_TabChanged (SelectedTab As TabPage)
	Select Case SelectedTab.Text
	Case "Preview"
		Dim lastView As String = AppView.Tag
		If lastView = "" Then Return
		'reload it
		Dim dir As String = File.GetFileParent(lastView)
		Dim fil As String = File.GetName(lastView)
		jMash.WebViewLoadFile(dir,fil,AppView)
	Case "HTML"
		Dim lastView As String = txtHTML.Tag
		If lastView = "" Then Return
		'reload it
		Dim dir As String = File.GetFileParent(lastView)
		Dim fil As String = File.GetName(lastView)
		jMash.ShowHTML(dir,fil,txtHTML)
	End Select
End Sub

