	DBUtils.AddEditRecord(CLI.AppSQL,"Pages","PageName",PageName,PageMap)
	jMash.InformUser(MainForm,PageName,"The page details have been saved.")
	wait for (CLI.ExecuteCommand(MainForm,$"serve_page ${PageName}"$)) complete(Result As Boolean)
	'Pages_Reload
End Sub


