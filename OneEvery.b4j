'clone a record with its children
Sub etvElemAttributes_Clone (RowIndex As Int, Value As Map)
	'get the old id
	Dim oldid As String = Value.getdefault("oldid9999","")
	'get the new id
	Dim id As String = Value.GetDefault("id","")
	Dim cat As String = Value.GetDefault("category","")
	'remove oldid
	Value.Remove("oldid9999")
	Select Case etvElemAttributes.datasource
	Case "Elements"
		ElementsProperties_Clone(oldid,id)
		'clone the kids
		ElementsChildren_Clone(oldid,id)
		ElementAttributes_Grid(cat)
		ElementsAttributesShow(id)
	End Select
End Sub

Sub ElementsAttributesShow(id As String)
	etvRecords.Clear
	etvElementClasses.clear
	lblTitle.Text = ""
	lblTitle2.Text = ""
	If id = "" Or id = "-1" Then Return
	'set the default property
	etvRecords.SetDefault("ElementID",id)
	etvRecords.SQLQuery = $"select * from attributes where ElementID = ${id} order by attribute desc"$
	etvRecords.LoadSQLData(Null)
	lblTitle.Text = $"Attributes: ${etvRecords.RecordCount+1}"$
	'load styles for the element
	etvElementClasses.SetDefault("ElementID",id)
	etvElementClasses.SQLQuery = $"select * from Classes where ElementID = ${id} order by class desc"$
	etvElementClasses.LoadSQLData(Null)
	lblTitle2.Text = $"Styles: ${etvElementClasses.RecordCount+1}"$
	'show the element
	Elements_Render(id)
End Sub

