'create lists, this is a universal list handler
'to write to the correct database table
Sub etvLists_Update (RowIndex As Int, Value As Map)
	'get the proparty bag
	Dim records As Map = etvLists.GetPropertyBag
	Dim DataBase As String  = etvLists.DataBase
	Dim DataSource As String = etvLists.DataSource
	Dim PrimaryKey As String = etvLists.PrimaryKey
	Dim SecondaryKey As String = etvLists.SecondaryKey
	Dim dir As String
	Dim fil As String
	
	Dim lstJSON As String = records.GetDefault("list","")
	If lstJSON = "" Then Return
	If DataBase <> "" And PrimaryKey <> "" And SecondaryKey <> "" Then
		dir = File.GetFileParent(DataBase)
		fil = File.GetName(DataBase)
		InternalSQL.InitializeSQLite(dir,fil,True)
		Dim spRecords() As String = jMash.StrParse(",",lstJSON)
		For Each strRecord As String In spRecords
			strRecord = strRecord.Trim.Replace(QUOTE,"").Replace("_","")
			strRecord = strRecord.Replace(TAB,"")
			If strRecord <> "" Then
				Dim nRecord As Map
				nRecord.initialize
				nRecord.Put(SecondaryKey,strRecord)
				DBUtils.AddEditRecord(InternalSQL,DataSource,SecondaryKey,strRecord,nRecord)
				Sleep(1)
			End If
		Next
	End If
	Select Case DataSource
	Case "Tags"
		Tags_Grid
	Case "Categories"
		Categories_Grid
	End Select
End Sub

