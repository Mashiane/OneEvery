Sub ElementsCategories_Reload(pItem As TreeItem)
	'clear the children
	pItem.Children.clear
	Dim nPage As TreeItem
	nPage.Initialize("treeProject","Div-Label-Input")
	nPage.Image = threeimg
	nPage.Expanded = True
	pItem.Children.Add(nPage)
	Dim lstFrames As List = DBUtils.ExecuteField(InternalSQL,"Elements","Framework",False,True) 
	For Each strFrame As String In lstFrames
		Dim nPage As TreeItem
		nPage.Initialize("treeProject",strFrame)
		nPage.Image = catimg
		nPage.Expanded = True
		pItem.Children.Add(nPage)
		'get the elements belonging to this framework
		Dim elments As List = DBUtils.ExecuteField1(InternalSQL,$"select distinct category from Elements where Framework = '${strFrame}' order by category"$,"category",False,True)
		For Each strElement As String In elments
			Dim nPage1 As TreeItem
			nPage1.Initialize("treeProject",strElement)
			nPage1.Image = catimg
			nPage1.Expanded = False
			nPage.Children.Add(nPage1)
		Next
	Next
	
	'Dim cats As List = DBUtils.ExecuteMaps(InternalSQL,"select category from elements group by category;",Null)
	'For Each catM As Map In cats
	'	Dim strcategory As String = catM.GetDefault("category","")
