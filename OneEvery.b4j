'universal records
Sub etvRecords_Update (RowIndex As Int, Value As Map)
	Select Case etvRecords.DataSource
	Case "CSSFiles"
		Dim id As String = Value.GetDefault("id","")
		Dim sfile As String = Value.GetDefault("file","")
		If File.Exists("",sfile) Then
			'copy the file
			File.Copy(File.GetFileParent(sfile),File.GetName(sfile),File.DirApp & "\css",File.GetName(sfile))
			sfile = File.GetName(sfile)
			Value.Put("file", sfile)
			DBUtils.AddEditRecord(CLI.AppSQL,"CSSFiles","id",id,Value)
			etvRecords.UpdateRow(RowIndex,Value) 
		End If
	Case "JSFiles"
		Dim id As String = Value.GetDefault("id","")
		Dim sfile As String = Value.GetDefault("file","")
		If File.Exists("",sfile) Then
			'copy the file
			File.Copy(File.GetFileParent(sfile),File.GetName(sfile),File.DirApp & "\js",File.GetName(sfile))
			sfile = File.GetName(sfile)
			Value.Put("file", sfile)
			DBUtils.AddEditRecord(CLI.AppSQL,"JSFiles","id",id,Value)
			etvRecords.UpdateRow(RowIndex,Value)
		End If
	Case "Frameworks"
	Case "Pages"
		Dim id As String = Value.GetDefault("id","")
		'get the page name
		PageName = Value.GetDefault("pagename","")
		Value.Put("htmlname",$"${PageName}.html"$)
		DBUtils.AddEditRecord(CLI.AppSQL,"Pages","id",id,Value)
		Pages_Reload
	Case "Elements"
		Dim id As String = Value.GetDefault("id","")
		'show the preview of the element
		Elements_Show(id)
		'update the category and tags if these dont exist
		Dim category As String = Value.GetDefault("category","")
		Dim typeof As String = Value.GetDefault("typeof","")
		Dim sframework As String = Value.GetDefault("framework","")
		If category <> "" Then
			Dim flds As Map = CreateMap("Category":category)
			DBUtils.AddEditRecord(InternalSQL,"Categories","Category",category,flds)
		End If
		If typeof <> "" Then
			Dim flds As Map = CreateMap("Tag":typeof)
			DBUtils.AddEditRecord(InternalSQL,"Tags","Tag",typeof,flds)
		End If
		'set the default framework and category when we add new records
		etvRecords.SetDefault("framework",sframework)
		etvRecords.SetDefault("category",category)
	Case "Attributes"
		'update the key field
		Dim id As String = Value.GetDefault("id","")
		Dim sElementID As String = Value.GetDefault("elementid","")
		Dim sAttribute As String = Value.GetDefault("attribute","")
		Dim sKey As String = $"${sElementID}.${sAttribute}"$
		'update the database
		DBUtils.RecordUpdateField(InternalSQL,"Attributes","Key",sKey,"id",id)
		Elements_Render(sElementID)
	Case "FrameworkClasses"
		'save the framework and the category
		Dim id As String = Value.GetDefault("id","")
		'update the category and tags if these dont exist
		Dim category As String = Value.GetDefault("category","")
		Dim sClass As String = Value.GetDefault("class","")
		Dim sframework As String = Value.GetDefault("framework","")
		'update the key of this class so that we dont have duplicates
		Dim sKey As String = $"${sframework}.${sClass}"$
		Dim flds As Map = CreateMap("key":sKey)
		DBUtils.AddEditRecord(InternalSQL,"FrameworkClasses","id",id,flds)
		'set the default framework and category when we add new records
		etvRecords.SetDefault("framework",sframework)
		etvRecords.SetDefault("category",category)
	Case "Devices"
		'update the key with framework & size
		Dim id As String = Value.GetDefault("id","")
		Dim sClassSize As String = Value.GetDefault("classsize","")
		'update the category and tags if these dont exist
		Dim sframework As String = Value.GetDefault("framework","")
		'update the key of this class so that we dont have duplicates
		Dim sKey As String = $"${sframework}.${sClassSize}"$
		Dim flds As Map = CreateMap("key":sKey)
		DBUtils.AddEditRecord(InternalSQL,"Devices","id",id,flds)
		'set the default framework and category when we add new records
		etvRecords.SetDefault("framework",sframework)
	End Select
End Sub

Sub ElementsChildren_Clone(oldid As String, id As String)
	'get the children belonging to this element
	Dim childs As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from elements where parentid = ${oldid}"$,Null)
	For Each rowMap As Map In childs
		Dim secKey As String = rowMap.GetDefault("element","")
		Dim childid As String = rowMap.GetDefault("id","")
		secKey = "Child of " & secKey
		'read the record from the database
		rowMap.Put("element",secKey)
		rowMap.Put("parentid",id)
		rowMap.remove("id")
		'create a new child record
		rowMap = DBUtils.AddReadRecord(InternalSQL,"Elements",rowMap)
		'the record was added well
		If rowMap.IsInitialized Then
			'get the new child id
			Dim newchildid As String = rowMap.GetDefault("id","")
			ElementsProperties_Clone(childid,newchildid)
			'second level
			ElementsChildren_Clone(childid,newchildid)
		End If
	Next
End Sub

'copy the element properties from old to new
Sub ElementsProperties_Clone(oldid As String, id As String)
	'copy attributes and classes for the element to new element
	Dim crecs As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Classes where ElementID = ${oldid}"$,Null)
	Dim arecs As List = DBUtils.executemaps(InternalSQL,$"select * from Attributes where ElementID = ${oldid}"$,Null)
	'declare insert list
	Dim attrn As List
	attrn.Initialize
	For Each attrm As Map In arecs
		'get the attribute name
		Dim sAttribute As String = attrm.GetDefault("attribute","")
		'define the new key
		Dim sKey As String = $"${id}.${sAttribute}"$
		'remove the id field
		attrm.Remove("id")
		'update the element id
		attrm.Put("elementid",id)
		'update the new key
		attrm.Put("key",sKey)
		'add to records we will insert
		attrn.Add(attrm)
	Next
	'update the database
	DBUtils.InsertMaps(InternalSQL,"Attributes",attrn,False)
	'***** process the classes
	'declare insert list
	Dim cttrn As List
	cttrn.Initialize
	For Each classm As Map In crecs
		'get the class name
		Dim sClass As String = classm.GetDefault("class","")
		'define the new key
		Dim sKey As String = $"${id}.${sClass}"$
		'remove the id field
		classm.Remove("id")
		'update the element id
		classm.Put("elementid",id)
		'update the new key
		classm.Put("key",sKey)
		'add to records we will insert
		cttrn.Add(classm)
	Next
	'update the database
	DBUtils.InsertMaps(InternalSQL,"Classes",cttrn,False)
End Sub

Sub etvRecords_Clone (RowIndex As Int, Value As Map)
	'get the old id
	Dim oldid As String = Value.getdefault("oldid9999","")
	'get the new id
	Dim id As String = Value.GetDefault("id","")
	Dim cat As String = Value.GetDefault("category","")
	'remove oldid
	Value.Remove("oldid9999")
	Select Case etvRecords.datasource
	Case "Attributes"
		'update the key field
		Dim id As String = Value.GetDefault("id","")
		Dim sElementID As String = Value.GetDefault("elementid","")
		Dim sAttribute As String = Value.GetDefault("attribute","")
		Dim sKey As String = $"${sElementID}.${sAttribute}"$
		'update the database
		DBUtils.RecordUpdateField(InternalSQL,"Attributes","Key",sKey,"id",id)
	Case "Elements"
		ElementsProperties_Clone(oldid,id)
		'close the kids
		ElementsChildren_Clone(oldid,id)
		Elements_Grid(cat)
		'show the selected element
		Elements_Show(id)
	End Select
End Sub

'universal records delete
Sub etvRecords_Delete (RowIndex As Int, Value As Map)
	Select Case etvRecords.DataSource
	Case "Frameworks"
	Case "Pages"
		Pages_Reload
	Case "Elements"
		'clear the property bag
		Dim id As String = Value.GetDefault("id","")
		Dim cat As String = Value.getdefault("category","")
		Element_Delete(id)
		Elements_Grid(cat)
		'show the selected element
		Elements_Show("")
	End Select
End Sub

