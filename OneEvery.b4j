'wrap an element inside a div
Sub Elements_WrapInside(value As Map, etv As EditableTV)
	'select all records for this parent id
	Dim cid As String = value.GetDefault("id","")
	'get the record from the db
	value = DBUtils.ReadRecord(InternalSQL,"Elements","id",cid)
	Dim swrapwith As String = value.GetDefault("wrapwith","")
	If swrapwith = "" Then swrapwith = "div"
	Dim pid As String = value.GetDefault("parentid","")
	Dim pca As String = value.getdefault("category","")
	Dim keys As List = etv.GetRowsKeys
	Dim skeys As String = jMash.MvFromList(keys,",")
	'add a new record that will host these items
	Dim nextid As Int = DBUtils.RecordCount(InternalSQL,"Elements","id")
	nextid = nextid + 1
	Dim div As Map
	div.Initialize
	div.Put("element","New Div")
	div.Put("framework", CLI.Framework)
	div.Put("category", pca)
	div.Put("typeof",swrapwith)
	div.Put("tabindex", nextid)
	div.Put("parentid", pid)
	div.Put("active","1")
	div = DBUtils.AddReadRecord(InternalSQL,"Elements",div)
	'get the new id
	Dim nid As String = div.GetDefault("id","")
	'everything that had this parent id should now be wrapped inside this div
	Dim sqlqry As String = $"update elements set parentid = ${nid} where parentid = ${pid} and id in (${skeys})"$
	DBUtils.RunQuery(InternalSQL,sqlqry,True)
	'update the newly created record
	div.Put("parentid", pid)
	div = DBUtils.AddEditRecord(InternalSQL,"Elements","id",nid,div)
End Sub

'draw the structure of the code
Sub HTML_Structure()
	'xml to map
'	'does the file exist, then parse it
	Dim ParsedData As Map
	ParsedData.Initialize
	If File.Exists(File.DirApp,"temp.xml") Then
		Dim xm As Xml2Map
		xm.Initialize
		ParsedData = xm.Parse(File.ReadString(File.dirapp, "temp.xml"))
		'stub
		Dim xml As XmlElement = xm.elements.Get(0)
		'html
		Dim xml1 As XmlElement = xml.Children.Get(0)
		'body
		cogTI.Children.clear
		Dim xml2 As XmlElement = xml1.Children.Get(1)
		For Each xmlChild As XmlElement In xml2.Children
			Dim htmlNode As TreeItem
			htmlNode.Initialize("treeProject",xmlChild.Name)
			htmlNode.Image = cogImg
			htmlNode.Expanded = True
			cogTI.Children.Add(htmlNode)
			'add the children
			XML2TreeView(xmlChild,htmlNode)
		Next
	End If
End Sub

