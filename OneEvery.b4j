'a class has been deleted, refresh the element
Sub classes_ItemDeleted (Value As String, m As Map)
	'get the element
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	'convert the saved item to a map
	Dim sClass As String = m.getdefault("class","")
	Dim key As String = $"${elID}.${sClass}"$
	DBUtils.DeleteRecord(InternalSQL,"Classes","key",key)
	'show the updated element
	Elements_Show(elID)
	tabElement.SelectedIndex = 2
End Sub

'a class has been updated, save it and show the new updated element
Sub classes_ItemUpdated (Value As String, m As String)
	'deal with current record only
	'get the element id
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	elID = elID.trim
	'convert the saved item to a map
	Dim attr As Map = jMash.Json2Map(m)
	Dim sclass As String = attr.getdefault("class","")
	Dim cid As String = attr.GetDefault("id","")
	Dim des As String = attr.GetDefault("description","")
	Dim dn As String = attr.GetDefault("displayname","")
	Dim sf As String = attr.GetDefault("framework","")
	Dim fxi As String = attr.GetDefault("fixed","0")
	Dim lst As String = attr.GetDefault("list","")
	Dim act As String = attr.GetDefault("active","0")
	sclass = sclass.trim
	cid = cid.Trim
	dn = dn.trim
	sf = sf.trim
	If elID = "" Or sclass = "" Or cid = "" Or dn = "" Then
		jMash.MsgBoxWarn(MainForm,"Class","The element / id / framework / class name / display name could not be identified, please enter these values.")
		Return
	End If
	'update the classes table with the element class
	Dim key As String = $"${elID}.${sclass}"$
	'update the attribute for saving
	attr.Put("elementid",elID)
	attr.Put("key",key)
	attr.Put("class",sclass)
	attr.Put("description",des)
	attr.Put("displayname",dn)
	attr.Put("fixed",fxi)
	attr.Put("list",lst)
	attr.Put("active",act)
	attr.Put("framework",sf)
	'update the classes for this element
	DBUtils.AddEditRecord(InternalSQL,"Classes","id",cid,attr)
	'if the framework classes match does not exist, create it
	Dim fk As String = $"${sf}.${sclass}"$
	If DBUtils.RecordExists(InternalSQL,"FrameworkClasses","key",fk) = False Then
		Dim fc As Map
		fc.Initialize 
		fc.Put("classname",dn)
		fc.Put("class",sclass)
		fc.Put("active","1")
		fc.Put("framework", sf)
		fc.Put("key",fk)
		fc.Put("category",dn)
		DBUtils.AddRecord(InternalSQL,"FrameworkClasses",fc)
	Else
		'read class from framework classes and just ensure is koacha
		Dim fc As Map = DBUtils.ReadRecord(InternalSQL,"FrameworkClasses","Key",fk)
		Dim scategory As String = fc.GetDefault("category","")
		Dim sClassName As String = fc.GetDefault("classname","")
		'do we have more classes fitting this category
		Dim lstClasses As List
		lstClasses.Initialize
		DBUtils.ExecuteList(InternalSQL,"select distinct Class from FrameworkClasses where category = '" & scategory & "' and Active = 1 order by class;",Null,0,lstClasses)
		Dim strList As String = jMash.MvFromList(lstClasses,"|")
		If jMash.MvCount(strList,"|")=1 Then strList = ""
		'update this row
		attr.Put("displayname",scategory)
		attr.Put("description",scategory)
		attr.Put("list",strList)
		If strList = "" Then attr.Put("description",sClassName)
		DBUtils.AddEditRecord(InternalSQL,"Classes","id",cid,attr)
	End If
	'lets update the frameworkclasses
	Elements_Show(elID)
	tabElement.SelectedIndex = 2
End Sub


