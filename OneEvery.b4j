'the creator database holds universal details
Sub Creator_Prepare
	InternalSQL.InitializeSQLite(File.dirapp,"creator.db",True)
	'component templates table
	DBUtils.InitializeNewTable("Templates","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("Instance",True,False)
	DBUtils.AddFieldOfText("TypeOf",True,False)
	DBUtils.AddFieldOfText("Name",True,False)
	DBUtils.AddFieldOfText("Text",True,False)
	DBUtils.AddFieldOfText("Value",True,False)
	DBUtils.AddFieldOfInteger("TextAfter",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfText("Template",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	'templates example
	DBUtils.InitializeNewTable("TemplatesAttributes","id","id")
	DBUtils.AddFieldOfText("Attribute",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfInteger("Fixed",False,False)
	DBUtils.AddFieldOfText("FieldType",False,False)
	DBUtils.AddFieldOfText("DefaultValue",False,False)
	DBUtils.AddFieldOfText("IsFile",False,False)
	DBUtils.AddFieldOfText("Description",False,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfText("ParentKey",True,False)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfInteger("Required",True,False)
	DBUtils.AddFieldOfText("Instance",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	DBUtils.InitializeNewTable("TemplatesClasses","id","id")
	DBUtils.AddFieldOfText("Class",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfInteger("Fixed",False,False)
	DBUtils.AddFieldOfText("FieldType",False,False)
	DBUtils.AddFieldOfText("DefaultValue",False,False)
	DBUtils.AddFieldOfText("IsFile",False,False)
	DBUtils.AddFieldOfText("Description",False,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfText("ParentKey",True,False)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfInteger("Required",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
		
	DBUtils.InitializeNewTable("Imports","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Name",True,False)
	DBUtils.AddFieldOfText("Text",True,False)
	DBUtils.AddFieldOfText("Attributes",True,False)
	DBUtils.AddFieldOfText("Placement",True,False)	
	DBUtils.AddFieldOfInteger("ElementsID",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create frameworks
	DBUtils.InitializeNewTable("Frameworks","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Framework",True,True)
	DBUtils.AddFieldOfText("Abbreviation",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	'create css
	DBUtils.InitializeNewTable("CSS","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("classname",True,False)
	DBUtils.AddFieldOfInteger("ElementID",True,False)
	DBUtils.AddFieldOfText("attribute",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("DefaultValue",False,False)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfInteger("Fixed",False,False)
	DBUtils.AddFieldOfInteger("OnPage",False,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfInteger("Multiple",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create elements
	DBUtils.InitializeNewTable("Elements","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Element",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("Category",True,False)
	DBUtils.AddFieldOfText("TypeOf",True,False)
	DBUtils.AddFieldOfText("Key",True,False)
	DBUtils.AddFieldOfText("Text",False,False)
	DBUtils.AddFieldOfText("Value",False,False)	
	DBUtils.AddFieldOfText("Contenteditable",False,False)
	DBUtils.AddFieldOfText("contextmenu",False,False)
	DBUtils.AddFieldOfText("draggable",False,False)
	DBUtils.AddFieldOfText("dropzone",False,False)
	DBUtils.AddFieldOfText("Hidden",False,False)
	DBUtils.AddFieldOfInteger("ParentID",True,False)
	DBUtils.AddFieldOfText("spellcheck",False,False)
	DBUtils.AddFieldOfInteger("TabIndex",True,False)
	DBUtils.AddFieldOfText("Name",True,False)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfInteger("TextAfter",True,False)
	DBUtils.AddFieldOfInteger("TextPropertyName",True,False)	
	DBUtils.AddFieldOfText("WrapWith",False,False)	
	DBUtils.CreateTableFromDefinition(InternalSQL)
	'create the attributes table, these are linked to elements
	DBUtils.InitializeNewTable("Attributes","id","id")
	DBUtils.AddFieldOfInteger("ElementID",True,False)
	DBUtils.AddFieldOfText("Attribute",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfInteger("Fixed",False,False)
	DBUtils.AddFieldOfText("FieldType",False,False)
	DBUtils.AddFieldOfText("DefaultValue",False,False)
	DBUtils.AddFieldOfText("IsFile",False,False)
	DBUtils.AddFieldOfText("MinRange",False,False)
	DBUtils.AddFieldOfText("MaxRange",False,False)
	DBUtils.AddFieldOfText("Description",False,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfInteger("Required",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	'create the classes tables, these are linked to elements
	DBUtils.InitializeNewTable("Classes","id","id")
	DBUtils.AddFieldOfInteger("ElementID",True,False)
	DBUtils.AddFieldOfText("Class",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("DisplayName",True,False)
	DBUtils.AddFieldOfText("Description",False,False)
	DBUtils.AddFieldOfText("Key",True,True)
	DBUtils.AddFieldOfInteger("Fixed",False,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfInteger("Active",True,False)	
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create tags
	DBUtils.InitializeNewTable("Tags","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Tag",True,True)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	'create categories for elements
	DBUtils.InitializeNewTable("Categories","id","id")
	DBUtils.AddFieldOfInteger("id",True,True)
	DBUtils.AddFieldOfText("Category",True,True)
	DBUtils.CreateTableFromDefinition(InternalSQL)
		
	'create classes that could be useful in elements
	DBUtils.InitializeNewTable("FrameworkClasses","id","id")
	DBUtils.AddFieldOfText("ClassName",True,False)
	DBUtils.AddFieldOfText("Class",True,False)
	DBUtils.AddFieldOfInteger("Active",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("Category",True,False)
	DBUtils.AddFieldOfText("List",False,False)
	DBUtils.AddFieldOfText("Key",True,True) ' framework plus class
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create devices
	DBUtils.InitializeNewTable("Devices","id","id")
	DBUtils.AddFieldOfText("ClassSize",True,False)
	DBUtils.AddFieldOfText("Description",True,False)
	DBUtils.AddFieldOfText("Framework",True,False)
	DBUtils.AddFieldOfText("Key",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create logs
	DBUtils.InitializeNewTable("Logs","id","id")
	DBUtils.AddFieldOfText("DoneOn",True,False)
	DBUtils.AddFieldOfText("Command",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
	
	'create macros
	DBUtils.InitializeNewTable("Macros","id","id")
	DBUtils.AddFieldOfText("macro",True,False)
	DBUtils.AddFieldOfText("key",True,True)
	DBUtils.AddFieldOfText("framework",True,False)
	DBUtils.addfieldoftext("Description",True,False)
	DBUtils.AddFieldOfText("arguements",True,False)
	DBUtils.AddFieldOfText("macrocode",True,False)
	DBUtils.CreateTableFromDefinition(InternalSQL)
End Sub

'create a context menu for the treeview
Sub ContextMenu_Build
	treeCM.Initialize("cm")
	Dim addMenu As List = jMash.CreateList(",","Add Div,Add U-nordered L-ist,Add LI-st Item,Add A-nchor")
	For Each amenu As String In addMenu
		Dim parentMenu As MenuItem
		parentMenu.Initialize(amenu, "treecm")
		treeCM.MenuItems.Add(parentMenu)
	Next
	'treeProject.ContextMenu = treeCM
End Sub


'detect which menu item was selected
Sub treecm_Action
   Dim mi As MenuItem = Sender
   Log(mi.Text)
End Sub

Sub AppStart (Form1 As Form, Args() As String)
	MainForm = Form1
	awesome = fx.LoadFont(File.DirAssets,"fontawesome-webfont.ttf",20)
	jMash.Initializekvs(File.DirApp, "oneevery.db")
	MainForm.Initialize("frm", 1230, 610)
	MainForm.RootPane.LoadLayout("vMain")
	splitMain.LoadLayout("vProjectTree")
	splitMain.LoadLayout("vParent")
	splitMain.LoadLayout("vProperty")
	splitMain.SetSizeLimits(0,300,300)
	splitMain.SetSizeLimits(2,500,500)
	jMash.MaximizeStage(MainForm)
	MainForm.Stylesheets.Add(File.GetUri(File.DirAssets, "table.css"))
	MainForm.Stylesheets.Add(File.GetUri(File.DirAssets, "listview.css"))
	ContextMenu_Build
	MainForm.Show
	Dlg.Initialize
	Dlg.SetParentWindow(MainForm)
	'prepare creator database
	Creator_Prepare
	CLI.Initialize
	MainForm.Title = "OneEvery"
	MainForm.BackColor = fx.Colors.white
	MainForm.Icon = fx.LoadImage(File.DirAssets, "seasons.png")
	
	File.MakeDir(File.DirApp, "Projects")
	File.MakeDir(File.DirApp, "css")
	File.MakeDir(File.DirApp, "js")
	CreateStatusBar
	'initialize images
	appimg.Initialize(File.DirAssets,"app.png")
	folderimg.Initialize(File.DirAssets,"folder.png")
	pageimg.Initialize(File.DirAssets,"page_world.png")
	publishimg.Initialize(File.DirAssets,"build.png")
	appadd.Initialize(File.DirAssets,"application_add.png")
	pageadd.Initialize(File.DirAssets,"html_add.png")
	compimg.Initialize(File.dirassets,"brick.png")
	elImg.Initialize(File.DirAssets,"tag.png")
	tagImg.Initialize(File.DirAssets,"tag_blue.png")
	addTag.Initialize(File.DirAssets,"tag_blue_add.png")
	htmlImg.Initialize(File.DirAssets,"html.png")
	frameImg.Initialize(File.DirAssets,"package.png")
	frameAdd.Initialize(File.DirAssets,"package_add.png")
	catimg.Initialize(File.DirAssets,"cmy.png")
	attrImg.Initialize(File.DirAssets,"bricks.png")
	classImg.Initialize(File.DirAssets,"css.png")
	deviceimg.Initialize(File.DirAssets,"monitor.png")
	threeimg.Initialize(File.DirAssets,"bullet.png")
	cogImg.Initialize(File.DirAssets,"cog.png")
	terminal.Initialize(File.DirAssets,"terminal.png")
	scriptImg.Initialize(File.DirAssets,"script_link.png")
	templatesImg.Initialize(File.DirAssets,"templates.png")
	cogStart.Initialize(File.DirAssets,"cog_start.png")
	scriptcog.Initialize(File.DirAssets,"script_gear.png")
	InitializeTree
	
	'open the last project that the user was working on	
	'open the last project
	If jMash.ContainsKey("lastproject") Then
		CLI.AppMap = jMash.GetObject("lastproject")
		If CLI.AppMap.IsInitialized Then
			App_Initialize
			etvProject.SetPropertyBag(CLI.AppMap)
			CLI.App_GetDetails
			MainForm.Title = "OneEvery: " & CLI.AppName
			App_OpenDB
			jMash.WebViewLoadFile(CLI.App.wwwPath,"index.html",AppView)
			'jMash.ShowHTML(CLI.App.wwwpath,"index.html",txtHTML)
		End If
	End If
End Sub

'Return true to allow the default exceptions handler to handle the uncaught exception.
Sub Application_Error (Error As Exception, StackTrace As String) As Boolean
	Return True
End Sub

'draw a pie of the app statistics
Sub Creator_Grid
	'hide the property bag
	splitMain.SetSizeLimits(2,550,550)
	LoadMiddleLayout("vTabPane")
	AddTabLayout("vReport","Statistics")
	LoadPropertyBagLayout("vEmptyPanel")
	
	Dim tFrameworks As Int = DBUtils.RecordCount(InternalSQL,"Frameworks","id")
	Dim tCategories As Int = DBUtils.RecordCountQry(InternalSQL,"select count(*) from (select distinct category from elements)")
	Dim tElements As Int = DBUtils.RecordCountQry(InternalSQL,"select count(id) from Elements where parentid = 0")
	Dim tTags As Int = DBUtils.RecordCountQry(InternalSQL,"select count(*) from (select distinct typeof from elements)")
	Dim tPages As Int = DBUtils.RecordCount(CLI.AppSQL,"Pages","id")
	Dim tattr As Int = DBUtils.RecordCountQry(InternalSQL,"select count(*) from (select distinct attribute from attributes)")
	Dim tclass As Int = DBUtils.RecordCountQry(InternalSQL,"select count(*) from (select distinct class from classes)")
	Dim tdevices As Int = DBUtils.RecordCount(InternalSQL,"Devices","id")
	
	tblReport.ImagesFolder = ImagesFolder
	tblReport.setparentform( MainForm)
	tblReport.SetReportViewer
	'set up the fields etc
	tblReport.AddLabelProperty("Description","Description")
	tblReport.AddLabelProperty("Total","Total")
	tblReport.HasActions = False
	tblReport.RefreshColumns
	'add the records
	Dim lstRecords As List
	lstRecords.Initialize 
	lstRecords.Add(CreateMap("Description":"Frameworks","Total":tFrameworks))
	lstRecords.Add(CreateMap("Description":"Devices","Total":tdevices))
	lstRecords.Add(CreateMap("Description":"Categories","Total":tCategories))
	lstRecords.Add(CreateMap("Description":"Tags","Total":tTags))
	lstRecords.Add(CreateMap("Description":"Styles","Total":tclass))
	lstRecords.Add(CreateMap("Description":"Attributes","Total":tattr))
	lstRecords.Add(CreateMap("Description":"Elements","Total":tElements))
	lstRecords.Add(CreateMap("Description":"Pages","Total":tPages))
	tblReport.AddRows(lstRecords,True)
	'Creator_Pie(lstRecords)
End Sub

