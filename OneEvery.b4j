	Pages.Children.Clear
	Elements.Children.Clear
	Tags.Children.Clear
	Frameworks.Children.Clear
	Categories.Children.clear
	devices.children.clear
	classTI.Children.clear
	attrTI.Children.clear
	cogTI.Children.clear
	templates.Children.clear
	Macros.Children.clear
End Sub


Sub CSSFiles_Show
	'add the vertical splitter
	splitMain.SetSizeLimits(2,1,1)
	LoadMiddleLayout("vTabPane")
	AddTabLayout("vRecords","CSS Files")
	LoadPropertyBagLayout("")
	btnToPage.Visible = False
	btnGenerateCode.Visible = False
	btnRecordNames.Visible = False
	etvRecords.ImagesFolder = ImagesFolder
	etvRecords.setparentform(MainForm)
	etvRecords.SetReportViewer
	'set up the fields etc
	etvRecords.PrimaryKey = "id"
	etvRecords.SecondaryKey = "file"
	etvRecords.AddTextBoxProperty("id","","ID","id")
	etvRecords.AddFilePickerProperty("CSS Script","","File to add to the website","file")
	Dim lstFrameworks As List = DBUtils.ExecuteField(InternalSQL,"Frameworks","Framework",False,True)
	etvRecords.AddComboBoxProperty("Framework",CLI.Framework,"Framework","framework",lstFrameworks,True)
	etvRecords.AddCheckBoxProperty("Active","1","Active","Active")
	etvRecords.AddTextBoxProperty("Tab Index","0","Value","TabIndex")
	etvRecords.ShowUpdate = True
	etvRecords.ShowDelete = True
	etvRecords.ShowAddChild = False
	etvRecords.ShowMoveDown = True
	etvRecords.ShowMoveUp = True
	etvRecords.ShowClone = True
	etvRecords.DataSource = "CSSFiles"
	etvRecords.TabIndex = "TabIndex"
	etvRecords.DataBase = CLI.AppDB
	etvRecords.AlwaysTell = False
	etvRecords.HandleCrud = True
	etvRecords.SetWidth("id","50")
	etvRecords.SetWidth("File","600")
	etvRecords.SetWidth("Framework","200")
	etvRecords.RefreshColumns
	etvRecords.SQLQuery = "select * from cssfiles order by TabIndex desc"
	etvRecords.LoadSQLData(Null)
	lblTitle.Text = $"CSS Files: ${etvRecords.RecordCount+1}"$
End Sub

