'show the selected element from the elements grid
Sub Elements_Show(id As String)
	'read the element from the db
	Dim lstTypes As List = DBUtils.ExecuteField(InternalSQL,"Tags","Tag",False,True)
	Dim lstFrameworks As List = DBUtils.ExecuteField(InternalSQL,"Frameworks","Framework",False,True)
	Dim lstCategory As List = DBUtils.ExecuteField(InternalSQL,"Categories","Category",False,True)
	LoadPropertyBagLayout("vTabElement")
	tabElement.LoadLayout("vElementt","Element")
	tabElement.LoadLayout("vAttributes","Attributes")
	tabElement.loadlayout("vClasses","Styles")
	tabElement.LoadLayout("vCSS","CSS")
	Attributes_Initialize
	Classes_Initialize
	CSS_Initialize
	etvElement.ImagesFolder = ImagesFolder
	etvElement.SetParentForm(MainForm)
	etvElement.SetPropertyBagWidths(200,300)
	'set up the fields etc
	etvElement.PrimaryKey = "id"
	etvElement.SecondaryKey = "Element"
	etvElement.ReadOnly = etvElement.CreateList(",","id")
	etvElement.AddTextBoxProperty("id","","ID","id")
	etvElement.AddTextBoxProperty("Parent","0","Parent id of parent element","parentid")
	etvElement.AddTextBoxProperty("TabIndex","0","Tab index for sorting","TabIndex")
	etvElement.AddTextBoxProperty("Element ID","","Element ID","element")
	etvElement.AddTextBoxProperty("Element Name","","Element Name","name")	
	etvElement.AddComboBoxproperty("Instance","","Type","typeof",lstTypes,True)
	etvElement.AddComboBoxProperty("Framework",CLI.Framework,"Framework","framework",lstFrameworks,True)
	etvElement.AddComboBoxproperty("Category","","Category","category",lstCategory,False)
	etvElement.AddTextBoxProperty("Text","","Text","text")
	etvElement.AddTextBoxProperty("Text Property Name","","Text Property Name","Text Property Name")
	etvElement.AddTextBoxProperty("Value","","Value","value")
	etvElement.AddCheckBoxProperty("Active","1","Active","active")
	etvElement.AddCheckBoxProperty("Text After","0","TextAfter","TextAfter")
	etvElement.AddComboBoxproperty("Wrap With","","Wrap this element inside","WrapWith",etvElement.CreateList(",","div,ul,li"),True)
	'add global attributes
	etvElement.AddLabelProperty("Global Attributes","gbl")
	etvElement.AddCheckBoxProperty("Content Editable","0","Allows you to make an element editable","Contenteditable")
	etvElement.AddTextBoxProperty("Context Menu","","Associate this element with a menu element","contextmenu")
	etvElement.AddCheckBoxProperty("Draggable","0","Whether you can drag this element","draggable")
	etvElement.AddComboBoxproperty("Drop Zone","","What happens when an element is dropped on this element","dropzone",etvElement.CreateList(",",",copy,move,link"),True)
	etvElement.AddCheckBoxProperty("Hidden","0","Hides an element","hidden")
	etvElement.AddCheckBoxProperty("Spell Check","0","Whether the element needs its spelling /grammar checked","spellcheck")
	
	etvElement.ShowUpdate = True
	etvElement.ShowDelete = True
	etvElement.ShowAddChild = True
	etvElement.ShowMoveDown = False
	etvElement.ShowMoveUp = False
	etvElement.ShowClone = False
	etvElement.ParentID = "parentid"
	etvElement.DataSource = "Elements"
	etvElement.DataBase = File.Combine(File.DirApp,"creator.db")
	etvElement.TabIndex = "TabIndex"
	etvElement.AlwaysTell = False
	etvElement.AddSaveDeleteButton
	etvElement.HandleCrud = True
	etvElement.SetLoading(False)
	etvElement.SetRecord(id)
	'load the attributes for this element
	Attributes_Load(id)
	Classes_Load(id)
	CSS_Load(id)
	'preview the element
	Elements_Render(id)
End Sub

'load all the classes for the element
Sub Classes_Load(id As String)
	'clear any existing classes
	classes.Load("[]",150,150)
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize
	attr = DBUtils.ExecuteMaps(InternalSQL,$"select * from Classes where ElementID = ${id}"$,Null)
	'convert to json
	Dim attrJSON As String = jMash.List2JSON(attr)
	'load to the attributes editable tv
	classes.Load(attrJSON,150,150)
	classes.SetListViewSize(150,150)
	classes.EditTV.SetPropertyBagWidths(150,200)
End Sub

'load css for the element
Sub CSS_Load(id As String)
	'clear any existing css attributes
	css.Load("[]",150,150)
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize
	attr = DBUtils.ExecuteMaps(InternalSQL,$"select * from CSS where ElementID = ${id}"$,Null)
	'convert to json
	Dim attrJSON As String = jMash.List2JSON(attr)
	'load to the attributes editable tv
	css.Load(attrJSON,150,150)
	css.SetListViewSize(150,150)
	css.EditTV.SetPropertyBagWidths(150,200)
End Sub

'load all the attributes for the element
Sub Attributes_Load(id As String)
	'clear any existing attributes
	attributes.Load("[]",150,150)
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize 
	attr = DBUtils.ExecuteMaps(InternalSQL,$"select * from Attributes where ElementID = ${id}"$,Null)
	'convert to json
	Dim attrJSON As String = jMash.List2JSON(attr)
	'load to the attributes editable tv
	attributes.Load(attrJSON,150,150)
	attributes.SetListViewSize(150,150)
	attributes.EditTV.SetPropertyBagWidths(150,200)
End Sub

'render the attributes for the selected element
Sub Attributes_Add(iSQL As SQL,el As HTMLElement, id As String)
	'clear any existing attributes
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize 
	attr = DBUtils.ExecuteMaps(iSQL,$"select * from Attributes where ElementID = ${id} and Active = 1"$,Null)
	For Each attrm As Map In attr
		Dim Attribute As String = attrm.GetDefault("attribute","")
		Dim DefaultValue As String = attrm.GetDefault("defaultvalue","")
		Dim IsFile As String = attrm.GetDefault("isfile","0")
		If IsFile = "1" Then
			If DefaultValue.StartsWith("http") Then
			Else
				DefaultValue = $"file:///${CLI.App.wwwPath.Replace("\","//")}//${DefaultValue.Replace("/","//")}"$
			End If
		End If
		el.AddProperty(Attribute,DefaultValue)
	Next
End Sub

'render the classes for the selected element
Sub Classes_Add(iSQL As SQL,el As HTMLElement, id As String)
	'clear any existing attributes
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize 
	attr = DBUtils.ExecuteMaps(iSQL,$"select Class from Classes where ElementID = ${id} and Active = 1"$,Null)
	For Each attrm As Map In attr
		Dim sClass As String = attrm.GetDefault("class","")
		el.AddClass(sClass)
	Next
End Sub

'render the css styles for the selected element
Sub CSS_Add(el As HTMLElement, id As String)
	'clear any existing attributes
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize 
	attr = DBUtils.ExecuteMaps(InternalSQL,$"select attribute,DefaultValue from CSS where ElementID = ${id} and Active = 1 and OnPage = 0"$,Null)
	For Each attrm As Map In attr
		Dim sClass As String = attrm.GetDefault("attribute","")
		Dim sDefaultValue As String = attrm.GetDefault("defaultvalue","")
		el.AddStyleAttribute(sClass,sDefaultValue)
	Next
End Sub

'add style to page
Sub Style_Add(el As HTMLElement, id As String)
	'clear any existing attributes
	If id = "" Or id = "-1" Then Return
	'get the attributes for the element
	Dim attr As List
	attr.Initialize 
	attr = DBUtils.ExecuteMaps(InternalSQL,$"select classname,attribute,DefaultValue,multiple from CSS where ElementID = ${id} and Active = 1 and OnPage = 1"$,Null)
	For Each attrm As Map In attr
		Dim classname As String = attrm.GetDefault("classname","")
		Dim attribute As String = attrm.GetDefault("attribute","")
		Dim DefaultValue As String = attrm.GetDefault("defaultvalue","")
		Dim multiple As String = attrm.GetDefault("multiple","")
		Dim nLine As String = $"${attribute}:${DefaultValue};"$
		If multiple = "0" Then
			el.AddCssRule(classname,nLine)
		Else
			el.addcssrule(classname,DefaultValue)
		End If
	Next
End Sub

private Sub CleanID(propTag As String) As String
	'check if property does not exist
	propTag = propTag.replace(".","").replace(" ","").Replace("null","").ToLowerCase.Trim
	Return propTag
End Sub

'build the element and show how it is defined
Sub Elements_Render(id As String)
	'clear existing preview and source
	AppView.LoadHtml("")
	'jMash.CodeAreaSetText(txtHTML,"","1",False)
	If id = "" Then Return
	'prepare the app for publishing
	App_PreparePublish
	'read the element from database
	Dim element As String = DBUtils.ReadField(InternalSQL,"Elements","id",id,"Element")
	Dim source As String = Elements_Build(id)
	'source = source.Replace(">",">" & CRLF)
	'create an empty page to preview this element
	Dim pgSource As HTMLPage
	pgSource.Initialize(CLI.App,"index")
	pgSource.PageTitle = element
	If CLI.SiteTitle <> "" Then
		pgSource.PageTitle = element & " | " & CLI.SiteTitle
	End If
	pgSource.AddContent(source)
	Style_Add(pgSource.Style,id)
	pgSource.build
	'build the structure
	source = jMash.HTML_TidyCode(source)
	HTML_Structure
	'jMash.CodeAreaSetText(txtHTML,source,"1",False)
	jMash.WebViewLoadFile(CLI.App.wwwPath,"index.html",AppView)
End Sub

'preview the actual app page
Sub Page_Preview(pgName As String)
	'clear the code and preview
	AppView.LoadHtml("")
	jMash.CodeAreaSetText(txtHTML,"","1",False)
	'build the page
	wait for (Page_Build(pgName)) complete(Result As Boolean)
	jMash.WebViewLoadFile(CLI.App.wwwPath,$"${pgName}.html"$,AppView)
	jMash.ShowHTML(CLI.App.wwwpath,$"${pgName}.html"$,txtHTML)
End Sub


Sub Elements_Build(id As String) As String
	If id = "" Then Return ""
	Dim ElementMap As Map = DBUtils.ReadRecord(InternalSQL,"Elements","id",id)
	If ElementMap.IsInitialized = False Then Return ""
	Dim typeof As String = ElementMap.GetDefault("typeof","")
	Dim text As String = ElementMap.GetDefault("text","")
	Dim value As String = ElementMap.GetDefault("value","")
	Dim Element As String = ElementMap.GetDefault("element","")
	Dim contenteditable As String = ElementMap.GetDefault("contenteditable","0")
	Dim contextmenu As String = ElementMap.GetDefault("contextmenu","")
	Dim draggable As String = ElementMap.GetDefault("draggable","0")
	Dim dropzone As String = ElementMap.GetDefault("dropzone","")
	Dim sname As String = ElementMap.GetDefault("name","")
	Dim spellcheck As String = ElementMap.GetDefault("spellcheck","0")
	Dim textafter As String = ElementMap.GetDefault("textafter","0")
	Dim wrapwith As String = ElementMap.GetDefault("wrapwith","")
	If contenteditable = "1" Then contenteditable = "true"
	If contenteditable = "0" Then contenteditable = "false"
	If draggable = "0" Then draggable = "false"
	If draggable = "1" Then draggable = "true"
	If spellcheck = "1" Then spellcheck="true"
	If spellcheck="0" Then spellcheck="false"
	Dim eid As String = CleanID(Element)
	'lets create the element
	Dim El As HTMLElement
	El.Initialize(eid,typeof)
	El.TextAfter = IIf(textafter="0",False,True)
	El.Text = text
	If value <> "" Then El.SetVALUE(value)
	'update global variables
	If contenteditable = "true" Then El.SetContentEditable(contenteditable)
	If contextmenu <> "" Then El.AddProperty("contextmenu",contextmenu)
	If draggable = "true" Then El.SetDraggable(draggable)
	If dropzone <> "" Then El.AddProperty("dropzone",dropzone)
	If spellcheck="true" Then El.AddProperty("spellcheck",spellcheck)
	If sname <> "" Then El.setname(sname)
	
	'add the attributes
	Attributes_Add(InternalSQL,El,id)
	'add the classes
	Classes_Add(InternalSQL,El,id)
	'add the css styles
	CSS_Add(El,id)
	'find other children
	Dim sbChilds As StringBuilder
	sbChilds.Initialize 
	Dim childs As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Elements where parentid = ${id} and active = 1 order by tabindex"$,Null)
	For Each childM As Map In childs
		Dim childid As String = childM.GetDefault("id","")
		sbChilds.Append(Elements_Build(childid))
	Next
	El.AddContent(sbChilds.ToString)
	If wrapwith <> "" Then
		Dim parentEL As HTMLElement
		parentEL.Initialize("",wrapwith)
		parentEL.AddElement(El)
		Return parentEL.html
	End If
	Return El.html
End Sub

'build the components for the page
Sub Components_Build(id As String) As String
	If id = "" Then Return ""
	Dim ElementMap As Map = DBUtils.ReadRecord(CLI.appsql,"Components","id",id)
	If ElementMap.IsInitialized = False Then Return ""
	Dim typeof As String = ElementMap.GetDefault("typeof","")
	Dim text As String = ElementMap.GetDefault("text","")
	Dim value As String = ElementMap.GetDefault("value","")
	Dim Element As String = ElementMap.GetDefault("element","")
	Dim sname As String = ElementMap.GetDefault("name","")
	Dim textafter As String = ElementMap.GetDefault("textafter","0")
	Dim eid As String = CleanID(Element)
	'lets create the element
	Dim El As HTMLElement
	El.Initialize(eid,typeof)
	El.TextAfter = iif(textafter="0",False,True)
	El.Text = text
	If value <> "" Then El.SetVALUE(value)
	If sname <> "" Then El.setname(sname)
	'update global variables
	Attributes_Add(CLI.appsql,El,id)
	'add the classes
	Classes_Add(CLI.AppSQL,El,id)
	'add the css styles
	'CSS_Add(El,id)
	'find other children
	Dim sbChilds As StringBuilder
	sbChilds.Initialize 
	Dim childs As List = DBUtils.ExecuteField1(CLI.appsql,$"select id from Components where parentid = ${id} and Active = 1 order by tabindex"$,"id",False,True)
	For Each childM As String In childs
		sbChilds.Append(Components_Build(childM))
	Next
	El.AddContent(sbChilds.ToString)
	Return El.html
End Sub


