'add a page to the app
Sub Page_Add
	Page_Initialize
	Dim np As Int = DBUtils.LastRecordID(CLI.AppSQL,"Pages","id")
	np = np + 1
	etvPage.SetProperty("tabindex",np)
	etvPage.SetProperty("active","1")
End Sub

'open a page and show in the property bag
Sub Page_Open(pgName As String)
	Page_Initialize
	PageMap = DBUtils.ReadRecord(CLI.AppSQL,"Pages","PageName",pgName)
	If PageMap.IsInitialized = False Then Return
	etvPage.SetPropertyBag(PageMap)
	jMash.WebViewLoadFile(CLI.App.wwwPath,$"${pgName}.html"$,AppView)
	jMash.ShowHTML(CLI.App.wwwpath,$"${pgName}.html"$,txtHTML)
End Sub

'reload pages to the tree
Sub Pages_Reload
	'clear the children
	Pages.Children.clear
	'add a new page link
	Dim nPage As TreeItem
	nPage.Initialize("treeProject","New Page")
	nPage.Image = pageadd
	nPage.Expanded = False
	Pages.Children.Add(nPage)
	Dim dbPages As List = DBUtils.ExecuteField(CLI.AppSQL,"Pages","pagename",False,True)
	For Each strpage As String In dbPages
		Dim nPage As TreeItem
		nPage.Initialize("treeProject",strpage)
		nPage.Image = htmlImg
		nPage.Expanded = False
		Pages.Children.Add(nPage)
	Next
End Sub

Sub Templates_Load
	'clear the children
	templates.Children.clear
	Dim temps As List = DBUtils.ExecuteField(InternalSQL,"Templates","Framework",False,True)
	For Each strTemp As String In temps
		Dim nPage As TreeItem
		nPage.Initialize("treeProject",strTemp)
		nPage.Image = templatesImg
		nPage.Expanded = False
		templates.Children.Add(nPage)
	Next
End Sub


