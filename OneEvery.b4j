'parse the html text to OneEvery format
Sub btnEditorParse_Click	
	Dim sText As String = txtHTMLSource.Text
	jMash.PutSimple("lasteditor",sText)
	sText = sText.Replace(CRLF,"")
	sText = sText.trim
	'clear existing preview and source
	AppView.LoadHtml("")
	cogTI.Children.clear
	If sText = "" Then Return
	App_PreparePublish
	jMash.HTML_TidyCode(sText)
	HTML_Structure
	Editor_Preview(sText)
	'save
End Sub

'This function is called recursively until all nodes are loaded
Private Sub XML2TreeView(xmlNode As XmlElement, treeNode As TreeItem)
	For Each xmlChild1 As XmlElement In xmlNode.children
		Dim htmlNode As TreeItem
		htmlNode.Initialize("treeProject",xmlChild1.Name)
		htmlNode.Image = cogImg
		htmlNode.Expanded = True
		treeNode.Children.Add(htmlNode)
		XML2TreeView(xmlChild1,htmlNode)
	Next
End Sub



