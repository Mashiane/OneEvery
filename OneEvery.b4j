'default value to list
Sub etvTemplatesAttributes_List (RowIndex As Int, Value As Map)
	Dim sdefaultvalue As String = Value.GetDefault("defaultvalue","")
	Dim slist As String = Value.GetDefault("list","")
	slist = slist.ToLowerCase
	sdefaultvalue = sdefaultvalue.tolowercase
	slist = jMash.MvAdd(slist,"|",sdefaultvalue)
	slist = jMash.MvRemoveDuplicates(slist,"|")
	'update the row
	Value.Put("list",slist)
	Value.Put("defaultvalue","")
	etvTemplatesAttributes.SaveRecord(RowIndex,Value)
End Sub


Sub btnRecordNames_Click
	Select Case etvRecords.DataSource
		Case "FrameworkClasses"
			badge.Initialize
			Dim recCnt As Int = 0
			Dim recTot As Int = 0
			Dim dups As Map
			dups.Initialize
			Dim recs As List = DBUtils.ExecuteMaps(InternalSQL,"select * from FrameworkClasses",Null)
			For Each rec As Map In recs
				recCnt = recCnt + 1
				recTot = recTot + 1
				If recCnt = 5 Then
					badge.SetBadge1(btnRecordNames,recTot,0)
					recCnt = 0
					Sleep(1)
				End If
				Dim sid As String = rec.GetDefault("id","")
				Dim sClass As String = rec.GetDefault("class","")
				Dim sFramework As String = rec.GetDefault("framework","")
				Dim scategory As String = rec.getdefault("category","")
				Dim sClassName As String = sClass.Replace("-"," ")
				sClassName = jMash.ProperCase(sClassName)
				rec.Put("classname",sClassName)
				DBUtils.AddEditRecord(InternalSQL,"FrameworkClasses","id",sid,rec)
				'proces dups
				Dim skey As String = $"${sFramework}.${scategory}"$
				If dups.ContainsKey(skey) Then
					Dim lst As List
					lst = dups.Get(skey)
					lst.Add(sClass)
					dups.Put(skey,lst)
				Else
					Dim lst As List
					lst.Initialize
					lst.Add(sClass)
					dups.Put(skey,lst)
				End If
			Next
			badge.SetBadge1(btnRecordNames,recTot,0)
			recTot = 0
			recCnt = 0
			'now update the list field of the classes
			For Each strKey As String In dups.Keys
				recTot = recTot + 1
				recCnt = recCnt + 1
				If recCnt = 5 Then
					badge.SetBadge1(btnRecordNames,recTot,0)
					recCnt = 0
					Sleep(1)
				End If
				Dim lst As List = dups.Get(strKey)
				Dim str As String = jMash.MvFromList(lst,"|")
				Dim sFramework As String = jMash.MvField(strKey,1,".")
				Dim scategory As String = jMash.MvField(strKey,2,".")
				If lst.Size = 1 Then str = ""
				Dim w As Map = CreateMap("framework":sFramework,"category":scategory)
				Dim u As Map = CreateMap("list":str)
				DBUtils.UpdateRecord2(InternalSQL,"FrameworkClasses",u,w)
			Next			
			badge.SetBadge1(btnRecordNames,recTot,0)
			
			'check for duplicates
			Dim dups As Map
			dups.Initialize 
			For Each rec As Map In recs
				Dim skey As String = rec.GetDefault("key","")
				Dim sid As String = rec.GetDefault("id","")
				If dups.ContainsKey(skey) Then
					Dim lst As List
					lst = dups.Get(skey)
					lst.Add(sid)
					dups.Put(skey,lst)
				Else
					Dim lst As List
					lst.Initialize
					lst.Add(sid) 
					dups.Put(skey,lst)
				End If
			Next
			Dim lstDups As List
			lstDups.Initialize 
			For Each strKey As String In dups.Keys
				Dim lst As List = dups.Get(strKey)
				If lst.Size > 1 Then
					For Each sid As String In lst
						lstDups.Add(sid)
					Next
				End If
			Next
			Dim sid As String = jMash.MvFromList(lstDups,",")
			etvRecords.SQLQuery = $"select * from FrameworkClasses where id in (${sid}) order by ClassName desc"$
			etvRecords.LoadSQLData(Null)
			badge.SetBadge(btnRecordNames,0)
	End Select
End Sub

