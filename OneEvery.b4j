'a css attribute has been updated, save it and show the new updated element
Sub css_ItemUpdated (Value As String, m As String)
	'deal with current record only
	'get the element id
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	elID = elID.trim
	'convert the saved item to a map
	Dim attr As Map = jMash.Json2Map(m)
	Dim aid As String = attr.GetDefault("id","")
	Dim attribute As String = attr.getdefault("attribute","")
	Dim classname As String = attr.GetDefault("classname","")
	attribute = attribute.trim
	If elID = "" Or aid = "" Or classname = "" Then
		jMash.MsgBoxWarn(MainForm,"CSS Attribute","The class name/ element / attribute name could not be identified.")
		Return
	End If
	Dim key As String = $"${elID}.${classname}"$
	'update the attribute for saving
	attr.Put("elementid",elID)
	attr.Put("key",key)
	DBUtils.AddEditRecord(InternalSQL,"CSS","id",aid,attr)
	Elements_Show(elID)
	tabElement.SelectedIndex = 3
End Sub


'an attribute had been deleted, refresh the element
Sub attributes_ItemDeleted (Value As String, m As Map)
	'get the element
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	'convert the saved item to a map
	Dim attribute As String = m.getdefault("attribute","")
	Dim key As String = $"${elID}.${attribute}"$
	DBUtils.DeleteRecord(InternalSQL,"Attributes","key",key)
	'show the updated element
	Elements_Show(elID)
	'show attributes tab
	tabElement.SelectedIndex = 1
End Sub

'an attribute has been updated, save it and show the new updated element
Sub attributes_ItemUpdated (Value As String, m As String)
	'deal with current record only
	'get the element id
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	elID = elID.trim
	'convert the saved item to a map
	Dim attr As Map = jMash.Json2Map(m)
	Dim aid As String = attr.GetDefault("id","")
	Dim attribute As String = attr.getdefault("attribute","")
	attribute = attribute.trim
	If elID = "" Or attribute = "" Or aid = "" Then
		jMash.MsgBoxWarn(MainForm,"Attribute","The element / attribute name could not be identified.")
		Return
	End If
	Dim key As String = $"${elID}.${attribute}"$
	'update the attribute for saving
	attr.Put("elementid",elID)
	attr.Put("key",key)
	DBUtils.AddEditRecord(InternalSQL,"Attributes","id",aid,attr)
	Elements_Show(elID)
	tabElement.SelectedIndex = 1
End Sub

Sub attributes_ItemNew ()
	'update the primary key
	Dim np As Int = DBUtils.LastRecordID(InternalSQL,"Attributes","id")
	np = np + 1
	attributes.SetProperty(attributes.PrimaryKey,np)
	attributes.SetProperty("active","1")
End Sub

Sub classes_ItemNew ()
	'update the primary key
	Dim np As Int = DBUtils.LastRecordID(InternalSQL,"Classes","id")
	np = np + 1
	classes.SetProperty(classes.PrimaryKey,np)
	classes.SetProperty("active","1")
End Sub

Sub css_ItemNew ()
	'update the primary key
	'get the element id
	Dim el As Map = etvElement.GetPropertyBag
	Dim elID As String = el.GetDefault("id","")
	elID = elID.trim
	Dim np As Int = DBUtils.LastRecordID(InternalSQL,"CSS","id")
	np = np + 1
	css.SetProperty(css.PrimaryKey,np)
	css.SetProperty("elementid",elID)
	css.SetProperty("active","1")
End Sub

'an element is being updated
Sub etvElemAttributes_Update (RowIndex As Int, Value As Map)
	'update the category and tags if these dont exist
	Dim category As String = Value.GetDefault("category","")
	Dim typeof As String = Value.GetDefault("typeof","")
	Dim sFramework As String = Value.GetDefault("framework","")
	Dim sID As String = Value.GetDefault("id","")
	If category <> "" Then
		Dim flds As Map = CreateMap("Category":category)
		DBUtils.AddEditRecord(InternalSQL,"Categories","Category",category,flds)
	End If
	If typeof <> "" Then
		Dim flds As Map = CreateMap("Tag":typeof)
		DBUtils.AddEditRecord(InternalSQL,"Tags","Tag",typeof,flds)
	End If
	'set the default framework and category when we add new records
	etvElemAttributes.SetDefault("framework",sFramework)
	etvElemAttributes.SetDefault("category",category)
	etvRecords.SetDefault("ElementID",sID)
	etvRecords.SQLQuery = $"select * from attributes where ElementID = ${sID} order by attribute desc"$
	etvRecords.LoadSQLData(Null)
	lblTitle.Text = $"Attributes: ${etvRecords.RecordCount+1}"$
End Sub

'delete the element
Sub etvElemAttributes_Delete (RowIndex As Int, Value As Map)
	Dim id As String = Value.GetDefault("id","")
	Dim cat As String = Value.getdefault("category","")
	Element_Delete(id)
	ElementAttributes_Grid(cat)
	Elements_Show("")
End Sub

'add a new element
Sub btnNewRecord1_Click
	etvElemAttributes.AddNewRow
	etvRecords.Clear
	etvElementClasses.clear
End Sub

'show the attributes for the selected element
Sub etvElemAttributes_SelectedRow (RowIndex As Int, Value As Map)
	Dim id As String = Value.GetDefault("id","")
	Dim sparentid As String = Value.GetDefault("parentid","")
	Select Case sparentid
	Case "0"
		btnMacro.visible = True
		btnMacro.Tag = id
	Case Else
		btnMacro.visible = True
		'btnMacro.visible = False
		btnMacro.Tag = id
	End Select
	ElementsAttributesShow(id)
End Sub

Sub DivLabelInput
	'create the div
	Dim nextid As Int = DBUtils.RecordCount(InternalSQL,"Elements","id")
	nextid = nextid + 1
	Dim divint As Int = -1
	Dim div As Map
	div.Initialize 
	div.Put("element","New Div")
	div.Put("framework", CLI.Framework)
	div.Put("category", "New Form Controls")
	div.Put("typeof","div")
	div.Put("tabindex", nextid)
	div.Put("parentid", "0")
	div.Put("active","1")
	div = DBUtils.AddReadRecord(InternalSQL,"Elements",div)
	If div.IsInitialized Then
		'get last element added
		divint = div.GetDefault("id",-1)
		'add the label
		nextid = DBUtils.RecordCount(InternalSQL,"Elements","id")
		nextid = nextid + 1
		Dim lbl As Map
		lbl.Initialize
		lbl.Put("element","New Label")
		lbl.Put("framework", CLI.Framework)
		lbl.Put("category", "New Form Controls")
		lbl.Put("typeof","label")
		lbl.Put("tabindex", nextid)
		lbl.Put("parentid", divint)
		lbl.Put("active","1")
		lbl = DBUtils.AddReadRecord(InternalSQL,"Elements",lbl)
		'add the input control
		nextid = DBUtils.RecordCount(InternalSQL,"Elements","id")
		nextid = nextid + 1
		Dim inp As Map
		inp.Initialize
		inp.Put("element","New Input")
		inp.Put("framework", CLI.Framework)
		inp.Put("category", "New Form Controls")
		inp.Put("typeof","input")
		inp.Put("tabindex", nextid)
		inp.Put("parentid", divint)
		inp.Put("active","1")
		inp = DBUtils.AddReadRecord(InternalSQL,"Elements",inp)
	End If
End Sub


Sub Macros_Load
	Macros.Children.Clear
	Macros.Expanded = True
	Dim mf As List = DBUtils.ExecuteField(InternalSQL,"macros","framework",False,True)
	For Each sframework As String In mf
		sframework = jMash.ProperCase(sframework)
		Dim macro As TreeItem
		macro.Initialize("treeProject",sframework)
		macro.Image = cogStart
		Macros.Children.Add(macro)
		Dim lst As List = DBUtils.ExecuteField1(InternalSQL,$"select macro from macros where lower(framework) = '${sframework.tolowercase}'"$,"macro",False,True)
		For Each strMacro As String In lst
			Dim macro1 As TreeItem
			macro1.Initialize("treeProject",strMacro)
			macro1.Image = cogStart
			macro.Children.Add(macro1)
		Next
	Next
End Sub

Sub treeProject_MouseClicked (EventData As MouseEvent)
	Try
		Dim SelectedItem As TreeItem = jMash.TreeViewClickedItem(treeProject,EventData)
		If SelectedItem.IsInitialized = False Then Return
		nodeText = SelectedItem.Text
		Select Case nodeText
			Case "Macros"
				Macros_Load
			Case "CSS Files"
				CSSFiles_Show
			Case "JavaScript Files"
				JSFiles_Show
			Case "JavaScript"
				'show javascript play ground
				JavaScript_Show
			Case "CLI"
				'show the command line interface
				CLI_Show
			Case "PlayGround"
				SelectedItem.Children.clear
				Editor_Show
			Case "Div-Label-Input"
				'add a div with a label and input childs
				DivLabelInput
				Select Case SelectedItem.Parent.Text
				Case "Elements"
					Elements_Grid("New Form Controls")
				Case "Attributes"
					ElementAttributes_Grid("New Form Controls")
				End Select
			Case "Devices"
				'devices
				TreeClear
				Devices_Grid
			Case "Styles"
				'load style classes
				TreeClear
				StylesClasses_Grid("")
				StylesCategories_Reload(SelectedItem)
			Case "Attributes"
				TreeClear
				ElementAttributes_Grid("")
				ElementsCategories_Reload(attrTI)
			Case "Creator"
				'generate a report
				TreeClear
				Creator_Grid
			Case "Categories"
				If jMash.MsgBoxConfirm(MainForm,"Update","Do you want to update this list based on captured elements?") = "yes" Then
					Dim cats As List = DBUtils.ExecuteMaps(InternalSQL,"select category from elements group by category",Null)
					'clear the categories table
					DBUtils.TableClear(InternalSQL,"Categories")
					'reset the counter
					DBUtils.SQLiteResetCounter(InternalSQL,"Categories","id")
					Dim nList As List
					nList.Initialize
					For Each catM As Map In cats
						Dim scategory As String = catM.GetDefault("category","")
						Dim nrec As Map = CreateMap("category":scategory)
						nList.Add(nrec)
					Next
					DBUtils.InsertMaps(InternalSQL,"Categories",nList,False)
				End If
				TreeClear
				Categories_Grid
			Case "Templates"
				
				Templates_Load
				Templates_Grid("")
			Case "Frameworks"
				TreeClear
				Frameworks_Grid
			Case "New"
				'create a new app
				App_Initialize
			Case "App"
				'currently opened app
				App_Read
			Case "Open"
				App_Open
			Case "Publish"
				App_Publish
			Case "Elements"
				TreeClear
				App_PreparePublish ' just in case
				Elements_Grid("")
				ElementsCategories_Reload(Elements)
			Case "Tags"
				If jMash.MsgBoxConfirm(MainForm,"Update","Do you want to update this list based on captured elements?") = "yes" Then
					DBUtils.CreateListFromAnotherTable(InternalSQL,"Elements","typeof","Tags","tag","id")
				End If
				TreeClear
				Tags_Grid
			Case "Pages"
				TreeClear
				Pages_Reload
				Pages_Grid
			Case "New Page"
				Page_Add
			Case Else
				Dim parentText As String = SelectedItem.Parent.Text
				Select Case parentText
				Case "Pages"
					'we are viewing a page
					Page_Open(nodeText)
					jMash.PutSimple("active_page",nodeText)
				Case "Styles"
					StylesClasses_Grid(nodeText)
				Case Else
					'have we selected a framework
					Dim frameList As List = DBUtils.ExecuteField(InternalSQL,"Elements","Framework",False,True)
					Dim inList As Boolean = jMash.OnList(frameList,parentText)
					If inList = True Then
						'get parent
						parentText = SelectedItem.Parent.Parent.Text
						Log(parentText)
						Select Case parentText
						Case "Attributes"
							ElementAttributes_Grid(nodeText)
						Case "Elements"
							Elements_Grid(nodeText)
						Case "Macros"
							Macro_Show($"${SelectedItem.Parent.text}.${nodeText}"$)
						End Select
					Else
						Select Case parentText
						Case "Templates"
							Templates_Grid(nodeText)
						Case Else
							Elements_Grid("")
						End Select
					End If
				End Select
		End Select
	Catch
		Log(LastException)
	End Try
	
End Sub

'show the macro
Sub Macro_Show(sMacro As String)
	splitMain.SetSizeLimits(2,500,500)
	LoadMiddleLayout("vTabPane")
	AddTabLayout("vElementIT","Macro")
	splitElement.LoadLayout("vMacro")
	CLI_PropertyBag
	If PageName <> "" Then Page_Preview(PageName)
	'show the macro details
	Dim Macro As Map = DBUtils.ReadRecord(InternalSQL,"Macros","key",sMacro)
	If Macro.IsInitialized Then
		Dim sMacro As String = Macro.GetDefault("macro","")
		Dim sargue As String = Macro.GetDefault("arguements","")
		Dim scommand As String = Macro.GetDefault("macrocode","")
		Dim sdescription As String = Macro.GetDefault("description","")
		scommand = scommand.Replace("|",CRLF)
		txtArguements.Text = sargue
		txtMacroName.Text = sMacro
		txtDescription.Text = sdescription
		jMash.CodeAreaSetText(txtMacroCommands,scommand,"1",False)
	End If
	txtMacroName.RequestFocus
End Sub

Sub Macro_Test(sMacro As String,sValues As String) As Boolean
	Dim Macro As Map = DBUtils.ReadRecord(InternalSQL,"Macros","key",sMacro)
	If Macro.IsInitialized = False Then Return False
	Dim sMacro As String = Macro.GetDefault("macro","")
	Dim sargue As String = Macro.GetDefault("arguements","")
	Dim scommand As String = Macro.GetDefault("macrocode","")
	Dim sdescription As String = Macro.GetDefault("description","")
	scommand = scommand.Replace("|",CRLF)
	txtArguements.Text = sargue
	txtDescription.Text = sdescription
	jMash.CodeAreaSetText(txtMacroCommands,scommand,"1",False)
	'split the arguements
	Dim spArgue() As String = jMash.StrParse(" ",sargue)
	Dim spValues() As String = jMash.StrParse(" ",sValues)
	If spArgue.Length <= spValues.Length Then
		Dim maxa As Int = spArgue.Length
		'get rest of content for the last item
		Dim strRest As String = jMash.MvRest(" ",sValues,maxa)
		Dim strLast As String = jMash.MvRest(" ",sargue,maxa)
		Dim macroe As Map
		macroe.Initialize		
		Dim acnt As Int
		For acnt = 0 To maxa - 1
			Dim stra As String = spArgue(acnt)
			Dim strv As String = spValues(acnt)
			macroe.Put(stra,strv)
		Next
		'save last item 
		macroe.Put(strLast,strRest)
		For Each strKey As String In macroe.Keys
			Dim strVal As String = macroe.Get(strKey)
			scommand = scommand.Replace(strKey,strVal)
		Next
		jMash.CodeAreaSetText(txtMacroCommands,scommand,"1",False)
		btnExecute.Visible = True
	Else
		jMash.MsgBoxWarn(MainForm,"Macro","There is an error with the arguements and arguement values!")
		btnExecute.Visible = False
		Return False	
	End If
End Sub

'create the templates
Sub Templates_Execute
	If jMash.MsgBoxConfirm(MainForm,"Update","Do you want to update the templates based on captured elements?") = "no" Then Return
	Dim rTot As Int = 0
	Dim rCnt As Int = 0
	badge.Initialize 
	DBUtils.TableClear(InternalSQL,"Templates")
	DBUtils.TableClear(InternalSQL,"TemplatesAttributes")
	DBUtils.TableClear(InternalSQL,"TemplatesClasses")
	Dim recs As List = DBUtils.ExecuteMaps(InternalSQL,"Elements",Null)
	For Each recm As Map In recs
		rTot = rTot + 1
		rCnt = rCnt + 1
		If rCnt = 5 Then
			badge.SetBadge(btnRefreshTemplates,rTot)
			rCnt= 0
			Sleep(1)
		End If
		Dim sFramework As String = recm.GetDefault("framework","")
		Dim stypeof As String = recm.GetDefault("typeof","")
		Dim sKey As String = $"${sFramework}.${stypeof}"$
		Dim nrecord As Map
		nrecord.Initialize
		nrecord.Put("key",sKey)
		nrecord.Put("framework",sFramework)
		nrecord.Put("instance",stypeof)
		nrecord.Put("displayname",stypeof)
		DBUtils.AddEditRecord(InternalSQL,"Templates","key",sKey,nrecord)
	Next
	badge.SetBadge(btnRefreshTemplates,rTot)
	'process attributes
	rCnt = 0
	rTot = 0
	For Each recm As Map In recs
		rTot = rTot + 1
		rCnt = rCnt + 1
		If rCnt = 5 Then
			badge.SetBadge(btnRefreshTemplates,rTot)
			rCnt= 0
			Sleep(1)
		End If
		Dim sFramework As String = recm.GetDefault("framework","")
		Dim stypeof As String = recm.GetDefault("typeof","")
		Dim elid As String = recm.GetDefault("id","")
		Dim pKey As String = $"${sFramework}.${stypeof}"$
		Dim recal As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from attributes where ElementID = ${elid}"$,Null)
		For Each recalm As Map In recal
			Dim sAttribute As String = recalm.GetDefault("attribute","")
			Dim sDisplayName As String = recalm.GetDefault("displayname","")
			Dim sFieldType As String = recalm.GetDefault("fieldtype","")
			Dim sDefaultValue As String = recalm.GetDefault("defaultvalue","")
			Dim sisfile As String = recalm.GetDefault("isfile","0")
			Dim sfixed As String = recalm.GetDefault("fixed","0")
			Dim sKey As String = $"${sFramework}.${stypeof}.${sAttribute}"$
			Dim sDescription As String = recalm.GetDefault("description","")
			sDisplayName = sAttribute.replace("-"," ")
			sDisplayName = jMash.ProperCase(sDisplayName)
			'add to attributes
			Dim exista As Map = DBUtils.ReadRecord(InternalSQL,"TemplatesAttributes","Key",sKey)
			If exista.IsInitialized Then
				'record exists, update the values
				Dim oDisplayName As String = exista.GetDefault("displayname","")
				Dim ofixed As String = exista.GetDefault("fixed","")
				Dim oFieldType As String = exista.GetDefault("fieldtype","")
				Dim oDefaultValue As String = exista.GetDefault("defaultvalue","")
				Dim oisfile As String = exista.GetDefault("isfile","")
				Dim odescription As String = exista.GetDefault("description","")
				'update the contents
				oDisplayName = jMash.MvAdd(oDisplayName,"|",sDisplayName)
				ofixed = jMash.MvAdd(ofixed,"|",sfixed)
				oFieldType = jMash.MvAdd(oFieldType,"|",sFieldType)
				oDefaultValue = jMash.MvAdd(oDefaultValue,"|",sDefaultValue)
				oisfile = jMash.MvAdd(oisfile,"|",sisfile)
				odescription = jMash.MvAdd(odescription,"|",sDescription)
				'remove duplicates
				oDisplayName = jMash.MvRemoveDuplicates(oDisplayName,"|")
				ofixed = jMash.MvRemoveDuplicates(ofixed,"|")
				oFieldType = jMash.MvRemoveDuplicates(oFieldType,"|")
				oDefaultValue = jMash.MvRemoveDuplicates(oDefaultValue,"|")
				oisfile = jMash.MvRemoveDuplicates(oisfile,"|")
				odescription = jMash.MvRemoveDuplicates(odescription,"|")
				'update the database record
				exista.Put("displayname",oDisplayName)
				exista.Put("fixed",ofixed)
				exista.Put("fieldtype",oFieldType)
				exista.Put("defaultvalue",oDefaultValue)
				exista.Put("isfile",oisfile)
				exista.Put("description",odescription)
				DBUtils.AddEditRecord(InternalSQL,"TemplatesAttributes","key",sKey,exista)
			Else
				'record does not exist
				exista.Initialize 
				exista.Put("attribute",sAttribute)
				exista.Put("framework",sFramework)
				exista.Put("displayname",sDisplayName)
				exista.Put("fixed",sfixed)
				exista.Put("fieldtype",sFieldType)
				exista.Put("defaultvalue",sDefaultValue)
				exista.Put("isfile",sisfile)
				exista.Put("description",sDescription)
				exista.Put("key",sKey)
				exista.Put("parentkey",pKey)
				DBUtils.AddRecord(InternalSQL,"TemplatesAttributes",exista)
			End If
		Next
		'process classes
		Dim recal As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Classes where ElementID = ${elid}"$,Null)
		For Each recalm As Map In recal
			Dim sClass As String = recalm.GetDefault("class","")
			Dim sDisplayName As String = recalm.GetDefault("displayname","")
			Dim sfixed As String = recalm.GetDefault("fixed","0")
			Dim sKey As String = $"${sFramework}.${stypeof}.${sClass}"$
			Dim sDescription As String = recalm.GetDefault("description","")
			Dim slist As String = recalm.GetDefault("list","")
			sDisplayName = sClass.replace("-"," ")
			sDisplayName = jMash.ProperCase(sDisplayName)
			
			'add to classes
			Dim exista As Map = DBUtils.ReadRecord(InternalSQL,"TemplatesClasses","Key",sKey)
			If exista.IsInitialized Then
				'record exists, update the values
				Dim cDisplayName As String = exista.GetDefault("displayname","")
				Dim cfixed As String = exista.GetDefault("fixed","")
				Dim cdescription As String = exista.GetDefault("description","")
				Dim clist As String = exista.GetDefault("list","")
				'update the contents
				cDisplayName = jMash.MvAdd(cDisplayName,"|",sDisplayName)
				cfixed = jMash.MvAdd(cfixed,"|",sfixed)
				cdescription = jMash.MvAdd(cdescription,"|",sDescription)
				clist = jMash.MvAdd(clist,"|",slist)
				'remove duplicates
				cDisplayName = jMash.MvRemoveDuplicates(cDisplayName,"|")
				cfixed = jMash.MvRemoveDuplicates(cfixed,"|")
				cdescription = jMash.MvRemoveDuplicates(cdescription,"|")
				clist = jMash.MvRemoveDuplicates(clist,"|")
				'update the database record
				exista.Put("displayname",cDisplayName)
				exista.Put("fixed",cfixed)
				exista.Put("description",cdescription)
				exista.Put("list",clist)
				DBUtils.AddEditRecord(InternalSQL,"TemplatesClasses","key",sKey,exista)
			Else
				'record does not exist
				exista.Initialize
				exista.Put("class",sClass)
				exista.Put("framework",sFramework)
				exista.Put("displayname",cDisplayName)
				exista.Put("fixed",cfixed)
				exista.Put("description",cdescription)
				exista.Put("list",clist)
				exista.Put("key",sKey)
				exista.Put("parentkey",pKey)
				DBUtils.AddRecord(InternalSQL,"TemplatesClasses",exista)
			End If
		Next
	Next
	'update with framework classes
	rTot = 0
	rCnt = 0
	Dim fc As List = DBUtils.ExecuteMaps(InternalSQL,"select * from FrameworkClasses",Null)
	For Each rcmap As Map In fc
		rTot = rTot + 1
		rCnt = rCnt + 1
		If rCnt = 5 Then
			badge.SetBadge(btnRefreshTemplates,rTot)
			rCnt= 0
			Sleep(1)
		End If
		Dim sClass As String = rcmap.GetDefault("class","")
		Dim sFramework As String = rcmap.GetDefault("framework","")
		Dim scategory As String = rcmap.GetDefault("category","")
		Dim slist As String = rcmap.GetDefault("list","")
		Dim w As Map = CreateMap("class":sClass,"framework":sFramework)
		Dim u As Map = CreateMap("displayname":scategory,"description":scategory,"list":slist)
		DBUtils.RecordsUpdateWhere(InternalSQL,"TemplatesClasses",u,w)
		'update classes
		Dim w As Map = CreateMap("class":sClass,"framework":sFramework)
		Dim u As Map = CreateMap("displayname":scategory,"description":scategory,"list":slist)
		DBUtils.RecordsUpdateWhere(InternalSQL,"Classes",u,w)
	Next
	badge.SetBadge(btnRefreshTemplates,0)
	'remove remaining duplicates
	Dim rows As List = DBUtils.executemaps(InternalSQL,"select * from TemplatesClasses",Null)
	Dim dups As Map
	dups.Initialize
	rTot = 0
	rCnt = 0
	For Each row As Map In rows
		rTot = rTot + 1
		rCnt = rCnt + 1
		If rCnt = 5 Then
			badge.SetBadge(btnRefreshTemplates,rTot)
			rCnt= 0
			Sleep(1)
		End If
		Dim sid As String = row.GetDefault("id","")
		Dim sDisplayName As String = row.GetDefault("displayname","")
		Dim slist As String = row.getdefault("list","")
		Dim sParentKey As String = row.GetDefault("parentkey","")
		If slist <> "" Then
			Dim sKey As String = $"${sParentKey}~${sDisplayName}~${slist}"$
			If dups.ContainsKey(sKey) Then
				Dim lst As List
				lst = dups.Get(sKey)
				lst.Add(sid)
				dups.Put(sKey,lst)
			Else
				Dim lst As List
				lst.Initialize
				lst.Add(sid)
				dups.Put(sKey,lst)
			End If
		End If
	Next
	badge.SetBadge(btnRefreshTemplates,rTot)
	'if there are dups
	Dim delKeys As List
	delKeys.Initialize
	For Each strKey As String In dups.Keys
		Dim lst As List = dups.Get(strKey)
		Dim rTot As Int = lst.Size - 1
		Dim rCnt As Int
		If rTot > 0 Then
			For rCnt = 1 To rTot
				Dim itm As String = lst.Get(rCnt)
				delKeys.add(itm)
			Next
		End If
	Next
	Dim sid As String = jMash.MvFromList(delKeys,",")
	If sid <> "" Then
		DBUtils.ExecuteQuery(InternalSQL,$"delete from TemplatesClasses where id in (${sid})"$)
	End If
	badge.SetBadge(btnRefreshTemplates,0)
End Sub

Sub etvClassDefinition_Update (RowIndex As Int, Value As Map)
	'get the details entered by the user
	Dim styleM As Map = etvClassDefinition.GetPropertyBag
	Dim styleprefix As String = styleM.GetDefault("styleprefix","")
	Dim prefixdescription As String = styleM.GetDefault("prefixdescription","")
	Dim suffixes As String = styleM.GetDefault("suffixes","")
	Dim Framework As String = styleM.GetDefault("framework","")
	Dim category As String = styleM.GetDefault("category","")
	'save for later retrieval
	jMash.PutObject("classdefinition",styleM)
	'create the respective styles
	Dim spsuffixes() As String = jMash.StrParse(",",suffixes)
	For Each strSuffix As String In spsuffixes
		Dim sClass As String = $"${styleprefix}-${strSuffix}"$
		Dim sKey As String = $"${Framework}.${sClass}"$
		'check if not specified on devices
		Dim device As String = DBUtils.ReadField(InternalSQL,"Devices","ClassSize",strSuffix,"Description")
		If device <> "" Then strSuffix = device
		Dim sClassName As String = $"${prefixdescription} ${strSuffix}"$
		sClassName = jMash.ProperCase(sClassName)
		
		Dim rMap As Map
		rMap.Initialize
		rMap.Put("classname",sClassName)
		rMap.Put("class",sClass)
		rMap.Put("active","1")
		rMap.Put("framework", Framework)
		rMap.Put("category",category)
		rMap.Put("key",sKey)
		DBUtils.AddEditRecord(InternalSQL,"FrameworkClasses","key",sKey,rMap)
		Sleep(1)
	Next
	StylesClasses_Grid(category)
End Sub

Sub btnSaveAll_Click
	etvRecords.Save
	'update keys
	Select Case etvRecords.datasource
	Case "Attributes"
		Dim rows As List = etvRecords.getrows
		Dim rCnt As Int
		Dim rTot As Int = rows.Size - 1
		For rCnt = 0 To rTot
			Dim rowM As Map = rows.Get(rCnt)
			Dim sid As String = rowM.GetDefault("id","")
			Dim sElementID As String = rowM.GetDefault("elementid","")
			Dim sAttribute As String = rowM.GetDefault("attribute","")
			Dim sframework As String = rowM.GetDefault("framework","")
			Dim sKey As String = $"${sElementID}.${sAttribute}"$
			Dim sDisplayName As String = sAttribute.Replace("-"," ")
			Dim sDefaultValue As String = rowM.GetDefault("defaultvalue","")
			Dim sFieldType As String = rowM.GetDefault("fieldtype","")
			sDisplayName = jMash.ProperCase(sDisplayName)
			rowM.Put("displayname",sDisplayName)
			rowM.Put("key",sKey)
			If sDefaultValue.tolowercase = "true" Then
				rowM.Put("fieldtype","Boolean")
					sFieldType = "Boolean"
			Else if sDefaultValue.ToLowerCase = "false" Then
				rowM.Put("fieldtype","Boolean")
					sFieldType = "Boolean"
			End If
			DBUtils.EditRecord(InternalSQL,"Attributes","id",sid,rowM)
			etvRecords.UpdateRow(rCnt,rowM)
			Dim w As Map = CreateMap("framework":sframework,"attribute":sAttribute)
			Dim u As Map = CreateMap("displayname":sDisplayName,"fieldtype":sFieldType)
			DBUtils.RecordsUpdateWhere(InternalSQL,"TemplatesAttributes",u,w)
			Sleep(1)
		Next
		Elements_Render(sElementID)
	Case "Elements"
		'Dim rows As List = etvRecords.getrows
	Case "FrameworkClasses"
		Dim rows As List = etvRecords.getrows
		Dim rTot As Int = rows.Size - 1
		Dim rCnt As Int
		Dim dups As Map
		dups.Initialize 
		For rCnt = 0 To rTot
			Dim rowM As Map = rows.Get(rCnt)
			Dim sid As String = rowM.GetDefault("id","")
			Dim sframework As String = rowM.GetDefault("framework","")
			Dim sClass As String = rowM.GetDefault("class","")
			Dim scategory As String = rowM.GetDefault("category","")
			Dim sClassName As String = sClass.Replace("-"," ")
			sClassName = jMash.ProperCase(sClassName)
			Dim sKey As String = $"${sframework}.${sClass}"$
			rowM.Put("classname",sClassName)
			rowM.Put("key",sKey)
			DBUtils.EditRecord(InternalSQL,"FrameworkClasses","id",sid,rowM)
			'process duplicates
			Dim sKey As String = $"${sframework}.${scategory}"$
			If dups.ContainsKey(sKey) Then
				Dim lst As List
				lst = dups.Get(sKey)
				lst.Add(sClass)
				dups.Put(sKey,lst)
			Else
				Dim lst As List
				lst.Initialize
				lst.Add(sClass)
				dups.Put(sKey,lst)
			End If
				Sleep(1)
			Next
			'now update the list field of the classes
			For Each strKey As String In dups.Keys
				Dim lst As List = dups.Get(strKey)
				Dim str As String = jMash.MvFromList(lst,"|")
				Dim sframework As String = jMash.MvField(strKey,1,".")
				Dim scategory As String = jMash.MvField(strKey,2,".")
				If lst.Size = 1 Then str = ""
				Dim w As Map = CreateMap("framework":sframework,"category":scategory)
				Dim u As Map = CreateMap("list":str)
				DBUtils.UpdateRecord2(InternalSQL,"FrameworkClasses",u,w)
			Next
			Dim lst As List = etvRecords.GetRowsKeys
			Dim str As String = jMash.MvFromList(lst,",")
			etvRecords.SQLQuery = $"select * from FrameworkClasses where id in (${str}) order by class desc"$
			etvRecords.LoadSQLData(Null)
			'update templates
			Dim keys As String = etvRecords.GetRowsKeysString
			Dim lst As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from FrameworkClasses where id in (${keys})"$,Null)
			For Each row As Map In lst
				Dim sClassName As String = row.GetDefault("classname","")
				Dim sClass As String = row.GetDefault("class","")
				Dim sframework As String = row.getdefault("framework","")
				Dim scategory As String = row.GetDefault("category","")
				Dim slist As String = row.GetDefault("list","")
				Dim w As Map = CreateMap("class":sClass,"framework":sframework)
				Dim u As Map = CreateMap("displayname":scategory,"description":scategory,"list":slist)
				DBUtils.RecordsUpdateWhere(InternalSQL,"TemplatesClasses",u,w)
				'update classes
				Dim w As Map = CreateMap("class":sClass,"framework":sframework)
				Dim u As Map = CreateMap("displayname":scategory,"description":scategory,"list":slist)
				DBUtils.RecordsUpdateWhere(InternalSQL,"Classes",u,w)
			Next
	End Select
End Sub

