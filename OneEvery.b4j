Sub etvElementClasses_Update (RowIndex As Int, Value As Map)
	'get the class and update it
	Dim sid As String = Value.GetDefault("id","")
	Dim sClass As String = Value.GetDefault("class","")
	Dim sElementID As String = Value.GetDefault("elementid","")
	Dim des As String = Value.GetDefault("description","")
	Dim dn As String = Value.GetDefault("displayname","")
	Dim sf As String = Value.GetDefault("framework","")
	sClass = sClass.Trim
	sElementID = sElementID.trim
	If sClass = "" Or sElementID = "" Then Return
	'update the key field and save to database
	Dim sKey As String = $"${sElementID}.${sClass}"$
	Value.Put("key",sKey)
	'update the database
	DBUtils.AddEditRecord(InternalSQL,"Classes","id",sid,Value)
	'if the framework classes match does not exist, create it
	Dim fk As String = $"${sf}.${sClass}"$
	If DBUtils.RecordExists(InternalSQL,"FrameworkClasses","key",fk) = False Then
		Dim fc As Map
		fc.Initialize
		fc.Put("classname",dn)
		fc.Put("class",sClass)
		fc.Put("active","1")
		fc.Put("framework", sf)
		fc.Put("key",fk)
		fc.Put("category",dn)
		DBUtils.AddRecord(InternalSQL,"FrameworkClasses",fc)
	Else
		'read class from framework classes and just ensure is koacha
		Dim fc As Map = DBUtils.ReadRecord(InternalSQL,"FrameworkClasses","Key",fk)
		Dim scategory As String = fc.GetDefault("category","")
		Dim sClassName As String = fc.GetDefault("classname","")
		'do we have more classes fitting this category
		Dim lstClasses As List
		lstClasses.Initialize 
		DBUtils.ExecuteList(InternalSQL,"select distinct Class from FrameworkClasses where category = '" & scategory & "' and Active = 1 order by class;",Null,0,lstClasses)
		Dim strList As String = jMash.MvFromList(lstClasses,"|")
		If jMash.MvCount(strList,"|")=1 Then strList = ""
		'update this row
		Value.Put("displayname",scategory)
		Value.Put("description",scategory)
		Value.Put("list",strList)
		If strList = "" Then Value.Put("description",sClassName)
		DBUtils.AddEditRecord(InternalSQL,"Classes","id",sid,Value)
		etvElementClasses.UpdateRow(RowIndex,Value)
	End If
	Elements_Render(sElementID)
End Sub

