Sub etvRecords_FilePicked (RowIndex As Int, Value As Map)
	If Value.IsInitialized = False Then Return
	Dim sfile As String = Value.GetDefault("file","")
	If sfile = "" Then Return
	Dim sourcedir As String = File.GetFileParent(sfile)
	Dim sourcefil As String = File.GetName(sfile)
	Select Case etvRecords.DataSource
	Case "CSSFiles"
		'copy the file to the css folder
		Value.Put("file",sourcefil)
		etvRecords.UpdateRow(RowIndex,Value)
		jMash.File_Copy(sourcedir,sourcefil,File.DirApp & "\css",True)
	Case "JSFiles"
		'copy the file to the js folder
		Value.Put("file",sourcefil)
		etvRecords.UpdateRow(RowIndex,Value)
		jMash.File_Copy(sourcedir,sourcefil,File.DirApp & "\js",True)
	End Select
End Sub

