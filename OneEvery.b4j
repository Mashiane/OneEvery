End Sub

Sub btnGenerateCode_Click
	Select Case etvRecords.DataSource
		Case "FrameworkClasses"
			Dim rows As List = etvRecords.GetRows
			'get the category
			If rows.Size = 1 Then
				'this is a single class
				Dim row As Map = rows.Get(0)
				Dim scategory As String = row.getdefault("category","")
				Dim sframework As String = row.GetDefault("framework","")
				Dim sAbbreviation As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",sframework,"abbreviation")
				Dim className As String = sAbbreviation & scategory.Replace(" ","").trim
				className = File.Combine(CLI.CodePath,className & ".bas")
				'kill the file
				If File.Exists("",className) Then
					File.delete("",className)
				End If
			else If rows.Size >= 1 Then
				Dim row As Map = rows.Get(0)
				Dim scategory As String = row.getdefault("category","")
				Dim sframework As String = row.GetDefault("framework","")
				Dim sAbbreviation As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",sframework,"abbreviation")
				'get the ids of grid rows
				Dim sid As String = etvRecords.GetRowsKeysString
				'get the records
				Dim rows As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from FrameworkClasses where id in (${sid}) order by Class"$,Null)
				'define the file name
				Dim className As String = sAbbreviation & scategory.Replace(" ","").trim
				Dim actualClass As String = scategory.Replace(" ","").Trim
				className = File.Combine(CLI.CodePath,className & ".bas")
				'adding the class
				Dim sbAddClass As StringBuilder
				sbAddClass.Initialize
				sbAddClass.Append($"Sub Set${actualClass}(el as HTMLElement, varClass As String) As HTMLElement"$).Append(CRLF)
				
				'prepare the code
				Dim sbInit As StringBuilder
				sbInit.Initialize
				sbInit.Append("Sub Initialize").Append(CRLF)
				'declarations
				Dim sb As StringBuilder
				sb.initialize
				sb.Append($"B4J=true
Group=Default Group
ModulesStructureVersion=1
Type=Class
Version=6
@EndOfDesignText@
'Class module"$)
				sb.append(CRLF)
				sb.Append("'Enumeration for ").Append(sframework).Append(":").Append(scategory).append(CRLF)
				sb.Append("'Automatically generated by OneEvery, ").Append(jMash.LongDateTimeToday).Append(CRLF)
				sb.Append("Sub Class_Globals").Append(CRLF)				
				For Each row As Map In rows
					Dim sClass As String = row.GetDefault("class","")
					Dim sname As String = sClass.Replace("-"," ")
					sname = jMash.ProperCase(sname)
					sname = sname.Replace(" ","")
					Dim sDeclare As String = $"Public ${sname} As String"$
					Dim sInit As String = $"${sname} = "${sClass}""$
					Dim addit As String = $"el.RemoveClass("${sClass}")"$
					sb.Append(sDeclare).Append(CRLF)
					sbInit.Append(sInit).Append(CRLF)
					sbAddClass.append(addit).Append(CRLF)
				Next
				sb.Append("End Sub").Append(CRLF).Append(CRLF)
				sb.Append(sbInit.ToString)
				sb.Append("End Sub").Append(CRLF)
				Dim addit As String = $"el.AddClass(varClass)"$
				sbAddClass.Append(addit).Append(CRLF)
				sbAddClass.Append("Return el").Append(CRLF)
				sbAddClass.append("End Sub").Append(CRLF)
				sb.append(CRLF)
				sb.Append(sbAddClass.tostring)
				'write the file
				File.WriteString("",className,sb.ToString)
				'show the code
				Dim scode As String = File.ReadString("",className)
				'jMash.CodeAreaSetText(txtHTML,scode,"1",True)
			End If
	End Select
End Sub

'build the framework
Sub btnExtractClasses_Click
	Dim sText As String = txtHTMLSource.Text
	jMash.PutSimple("lasteditor",sText)
	sText = sText.Replace(CRLF,"")
	sText = sText.trim
	'clear existing preview and source
	AppView.LoadHtml("")
	cogTI.Children.clear
	If sText = "" Then Return
	jMash.HTML_TidyCode(sText)
	HTML_StructureSave
	'extract classes/attributes etc
	Dim rTot As Int = 0
	'save the imports to the elements
	badge.Initialize
	'get the abbreviation of the framework
	Dim sAbbreviation As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",CLI.framework,"abbreviation")
		
	Dim rows As List = DBUtils.ExecuteMaps(InternalSQL,"select * from Imports",Null)
	For Each row As Map In rows
		rTot = rTot + 1
		badge.SetBadge(btnExtractClasses,rTot)
		Sleep(1)
		'get the tag name
		Dim sName As String = row.GetDefault("name","")
		sName = sName.trim
		Dim sDisplayName As String = sAbbreviation & jMash.propercase(sName)
		Dim skey As String = $"${CLI.framework}.${sName}"$
		'update the tags
		Dim record As Map = CreateMap("tag":sName)
		DBUtils.AddRecord(InternalSQL,"Tags",record)
		'update the templates
		Dim record As Map = CreateMap("framework":CLI.Framework, _
			"instance":sName, _
			"displayname":sDisplayName, _
			"key":skey)
		DBUtils.AddRecord(InternalSQL,"Templates",record)
		'update the template classes
		Dim sAttributes As String = row.GetDefault("attributes","")
		If sAttributes <> "" Then
			Dim attrMap As Map = jMash.Json2Map(sAttributes)
			For Each attrKey As String In attrMap.Keys
				Dim attrValue As String = attrMap.Getdefault(attrKey,"")
				Select Case attrKey
				Case "id"
				Case "class"
					'split each of the classes
					Dim spClasses() As String = jMash.StrParse(" ",attrValue)
					For Each strClass As String In spClasses
						'convert to propercase
						strClass = strClass.trim
						Dim strCap As String = strClass
						strCap = strCap.Replace("-"," ")
						strCap = jMash.ProperCase(strCap)
						Dim fkey As String = $"${CLI.framework}.${strClass}"$
						'update framework classes
						Dim fc As Map = CreateMap("classname":strCap, _
						"class":strClass, _
						"active":"1", _
						"framework":CLI.Framework, _
						"key":fkey, _
						"category":strCap)
						DBUtils.AddRecord(InternalSQL,"FrameworkClasses",fc)
						'update templateclasses
						Dim tcparent As String = $"${CLI.framework}.${sName}"$
						Dim tckey As String = $"${tcparent}.${strClass}"$
						Dim tc As Map = CreateMap("class":strClass, _
						"framework":CLI.Framework, _
						"displayname": strCap, _
						"key":tckey, _
						"parentkey":tcparent)
						DBUtils.AddRecord(InternalSQL,"TemplatesClasses",tc)
					Next
				Case "style"
					'inline css class
					Log(sName)
					Log(attrValue)
				Case Else
					'update template attributes
					Dim sDisplayName As String = attrKey
					sDisplayName = sDisplayName.Replace("-"," ")
					sDisplayName = jMash.propercase(sDisplayName)
					Dim parentkey As String = $"${CLI.framework}.${sName}"$
					Dim attrKey1 As String = $"${parentkey}.${attrKey}"$
					'read existing template attributes
					Dim attrEM As Map = DBUtils.ReadRecord(InternalSQL,"TemplatesAttributes","key",attrKey1)
					If attrEM.IsInitialized Then
						Dim oFieldType As String = attrEM.GetDefault("fieldtype","")
						Dim oDefaultValue As String = attrEM.GetDefault("defaultvalue","")
						oFieldType = jMash.MvAdd(oFieldType,"|","String")
						oDefaultValue = jMash.MvAdd(oDefaultValue,"|",attrValue)
						oFieldType = jMash.MvRemoveDuplicates(oFieldType,"|")
						oDefaultValue = jMash.MvRemoveDuplicates(oDefaultValue,"|")
						Dim attrm As Map = CreateMap("key":attrKey1, _
						"fieldtype":oFieldType, _
						"defaultvalue":oDefaultValue)
						DBUtils.AddEditRecord(InternalSQL,"TemplatesAttributes","key",attrKey1,attrm)
					Else	
						Dim attrm As Map = CreateMap("attribute":attrKey, _
						"framework":CLI.Framework, _
						"displayname":sDisplayName, _
						"fieldtype":"String", _
						"defaultvalue": attrValue, _
						"isfile":"0", _
						"parentkey": parentkey, _
						"key":attrKey1)
						DBUtils.AddRecord(InternalSQL,"TemplatesAttributes",attrm)
					End If
				End Select
			Next
		End If
	Next
	badge.SetBadge(btnExtractClasses,0)
End Sub

'build the macro commands
Sub btnMacro_Click
	Dim sid As String = btnMacro.Tag
	Dim lstCommands As List
	lstCommands.Initialize
	'to hold the arguements that we need for the macro
	Dim sArguements As Map
	sArguements.Initialize
	sArguements.put("{id}","{id}")
	'read the element
	Dim elM As Map = DBUtils.ReadRecord(InternalSQL,"Elements","id",sid)
	Dim sFramework As String = elM.GetDefault("framework","")
	Dim sAbbrev As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",sFramework,"abbreviation")
	sFramework = jMash.propercase(sFramework)
	'get abbreviation
	Dim stypeof As String = elM.GetDefault("typeof","")
	Dim stext As String = elM.GetDefault("text","")
	Dim scategory As String = elM.GetDefault("category","")
	Dim selement As String = elM.GetDefault("element","")
	selement = jMash.GetAlpha(selement)
	'create the cli comments
	Dim scommand As String = $"add_element ${stypeof} {id}"$
	lstCommands.Add(scommand)
	'is there a text value
	If stext <> "" Then
		'is this an argument
		If stext.StartsWith("{") And stext.EndsWith("}") Then
			sArguements.put(stext,stext)
			scommand = $"set_text {id} ${stext}"$
			lstCommands.Add(scommand)
		Else
			scommand = $"set_text {id} ${stext}"$
			lstCommands.Add(scommand)
		End If
	End If
	'get the attributes for this element
	Dim attrL As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Attributes where ElementID = ${sid} and active = 1"$,Null)
	For Each attrM As Map In attrL
		Dim sAttribute As String = attrM.GetDefault("attribute","")
		Dim sDefaultValue As String = attrM.GetDefault("defaultvalue","")
		If sDefaultValue.StartsWith("{") And sDefaultValue.EndsWith("}") Then
			sArguements.put(sDefaultValue,sDefaultValue)
		End If
		scommand = $"add_attribute {id} ${sAttribute} ${sDefaultValue}"$
		lstCommands.Add(scommand)
	Next
	'process the classes
	Dim classL As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Classes where ElementID = ${sid} and active = 1"$,Null)
	For Each classM As Map In classL
		Dim sClass As String = classM.GetDefault("class","")
		scommand = $"add_class {id} ${sClass}"$
		lstCommands.Add(scommand)
	Next
	'get any children affected by this component
	ExtractChildrenForMacro("{id}",sid,lstCommands,sArguements)
	scommand = jMash.MvFromList(lstCommands,"|")
	Dim argue As String = jMash.MvFromKeys(sArguements," ")
	'save the macro
	Dim macro As Map
	macro.Initialize
	macro.put("macro", $"${sAbbrev}${selement}"$)
	macro.put("arguements",argue)
	macro.put("macrocode",scommand)
	macro.Put("description",scategory)
	macro.Put("framework",sFramework)
	jMash.PutObject("macro",macro)
	'show the macros screen
	frmMacros.Show(MainForm)
	
End Sub

Sub ExtractChildrenForMacro(ownerID As String,parentID As String,lstCommands As List,sArguements As Map)
	'get all children for this element
	Dim els As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from elements where parentid = ${parentID} and active = 1 order by tabindex"$,Null)
	Dim childTot As Int = 0
	Dim rCnt As Int
	Dim rTot As Int = els.Size - 1 
	For rCnt = 0 To rTot
		Dim elM As Map = els.Get(rCnt)
		childTot = childTot + 1
		'get abbreviation
		Dim idname As String = ownerID & "chld" & childTot
		Dim stypeof As String = elM.GetDefault("typeof","")
		Dim stext As String = elM.GetDefault("text","")
		Dim schild As String = elM.GetDefault("id","")
		'create the cli comments
		Dim scommand As String = $"add_element ${stypeof} ${idname}"$
		lstCommands.Add(scommand)
		'set the parent
		scommand = $"set_parent ${idname} ${ownerID}"$
		lstCommands.add(scommand)
		'is there a text value
		If stext <> "" Then
			'is this an argument
			If stext.StartsWith("{") And stext.EndsWith("}") Then
				sArguements.put(stext,stext)
				scommand = $"set_text ${idname} ${stext}"$
				lstCommands.Add(scommand)
			Else
				scommand = $"set_text ${idname} ${stext}"$
				lstCommands.Add(scommand)
			End If
		End If
		'get the attributes for this child element
		Dim attrL As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Attributes where ElementID = ${schild} and active = 1"$,Null)
		For Each attrM As Map In attrL
			Dim sAttribute As String = attrM.GetDefault("attribute","")
			Dim sDefaultValue As String = attrM.GetDefault("defaultvalue","")
			If sDefaultValue.StartsWith("{") And sDefaultValue.EndsWith("}") Then
				sArguements.put(sDefaultValue,sDefaultValue)
			End If
			scommand = $"add_attribute ${idname} ${sAttribute} ${sDefaultValue}"$
			lstCommands.Add(scommand)
		Next
		'process the classes
		Dim classL As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from Classes where ElementID = ${schild} and active = 1"$,Null)
		For Each classM As Map In classL
			Dim sClass As String = classM.GetDefault("class","")
			scommand = $"add_class ${idname} ${sClass}"$
			lstCommands.Add(scommand)
		Next
		'extract children if there are
		ExtractChildrenForMacro(idname,schild,lstCommands,sArguements)
	Next
End Sub

Sub btnSaveMacro_Click
	Dim sCode As String = txtMacroCommands.GetText
	If jMash.IsBlank(Dlg,txtMacroName.Text,"Macro Name") = True Then Return
	If jMash.IsBlank(Dlg,sCode,"Macro Code") = True Then Return
	
	sCode = sCode.Replace(CRLF,"|")
	Dim skey As String = $"${CLI.Framework}.${txtMacroName.text}"$
	Dim macro As Map = CreateMap("macro":txtMacroName.Text, _
	"arguements":txtArguements.Text, _
	"description":txtDescription.Text, _
	"framework":CLI.framework, _ 
	"key":skey, _
	"macrocode":sCode)
	DBUtils.AddEditRecord(InternalSQL,"Macros","key",skey,macro)
	If DBUtils.RecordExists(InternalSQL,"Macros","key",skey) = True Then
		jMash.MsgBoxInform(MainForm,"Macro: " & txtMacroName.text,"The macro was created successfully!")
	Else
		jMash.MsgBoxInform(MainForm,"Macro: " & txtMacroName.text,"The macro was NOT created successfully!")
	End If
End Sub

'test the macro
Sub btnPreview_Click
	If Macro_Test($"${CLI.Framework}.${txtMacroName.text}"$,txtValues.text) = False Then
		txtValues.RequestFocus
	End If
End Sub

Sub btnExecute_Click
	Dim scodes As String = txtMacroCommands.GetText
	scodes = scodes.trim
	If jMash.IsBlank(Dlg,scodes,"Macro Code") = True Then Return
	Dim codes() As String = jMash.StrParse(CRLF,scodes)
	For Each strCode As String In codes
		wait for (CLI.ExecuteCommand(MainForm,strCode)) complete(Result As Boolean)
	Next
	btnExecute.Visible = False
End Sub

Sub btnDeleteMacro_Click
	If jMash.IsBlank(Dlg,txtMacroName.Text,"Macro Name") = True Then Return
	Dim sKey As String = $"${CLI.framework}.${txtMacroName.text}"$
	DBUtils.RecordDelete(InternalSQL,"Macros","key",sKey)
	If DBUtils.RecordExists(InternalSQL,"Macros","key",sKey) = True Then
		jMash.MsgBoxInform(MainForm,"Macro: " & txtMacroName.text,"The macro was NOT deleted successfully!")
	Else
		jMash.MsgBoxInform(MainForm,"Macro: " & txtMacroName.text,"The macro was deleted successfully!")
	End If
End Sub

'create macros
Sub btnMacroRecords_Click
	'convert style classes to macros
	Select Case etvRecords.DataSource
	Case "FrameworkClasses"
		Dim rows As List = etvRecords.GetRows
		'get the category
		If rows.Size = 1 Then
			'this is a single class
			Dim row As Map = rows.Get(0)
			Dim sid As String = row.GetDefault("id","")
			Dim classM As Map = DBUtils.ReadRecord(InternalSQL,"FrameworkClasses","id",sid)
			Dim sClassName As String = classM.GetDefault("classname","")
			Dim sClass As String = classM.getdefault("class","")
			Dim sFramework As String = classM.GetDefault("framework","")
			Dim sAbbrev As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",sFramework,"abbreviation")
			Dim className As String = sAbbrev & sClassName.Replace(" ","").trim
			sFramework = jMash.ProperCase(sFramework)
			Dim lstCommands As List
			lstCommands.Initialize
			'to hold the arguements that we need for the macro
			Dim sArguements As Map
			sArguements.Initialize
			sArguements.put("{id}","{id}")
			Dim scommand As String = $"add_class {id} ${sClass}"$
			lstCommands.Add(scommand)
			scommand = jMash.MvFromList(lstCommands,"|")
			Dim argue As String = jMash.MvFromKeys(sArguements," ")
			Dim sKey As String = $"${sFramework}.${className}"$
			'save the macro
			Dim macro As Map
			macro.Initialize
			macro.put("macro", className)
			macro.put("arguements",argue)
			macro.put("macrocode",scommand)
			macro.Put("description",sClassName)
			macro.Put("framework",sFramework)
			macro.put("key",sKey)
			DBUtils.AddRecord(InternalSQL,"Macros",macro)
			jMash.PutObject("macro",macro)
			'show the macros screen
			frmMacros.Show(MainForm)
		else If rows.Size >= 1 Then
			'only one class is acceptable, so remove all first and then add the one you want
			Dim row As Map = rows.Get(0)
			Dim sFramework As String = row.GetDefault("framework","")
			Dim sAbbreviation As String = DBUtils.ReadField(InternalSQL,"Frameworks","Framework",sFramework,"abbreviation")
			sFramework = jMash.ProperCase(sFramework)
			'get the ids of grid rows
			Dim sid As String = etvRecords.GetRowsKeysString
			'get the records
			Dim rows As List = DBUtils.ExecuteMaps(InternalSQL,$"select * from FrameworkClasses where id in (${sid}) order by Class"$,Null)
			'ge all of the classes
			Dim allof As List = DBUtils.ExecuteField1(InternalSQL,$"select Class from FrameworkClasses where id in (${sid})"$,"class",False,True)
			Dim lstCommands As List
			lstCommands.Initialize
			'to hold the arguements that we need for the macro
			Dim sArguements As Map
			sArguements.Initialize
			sArguements.put("{id}","{id}")
			'process each class, remove all
			For Each classM As Map In rows
				Dim sClassName As String = classM.GetDefault("classname","")
				Dim sClass As String = classM.getdefault("class","")
				Dim className As String = sAbbreviation & sClassName.Replace(" ","").trim
				Dim sKey As String = $"${sFramework}.${className}"$
				'build the macro
				Dim lstCommands As List
				lstCommands.Initialize
				'to hold the arguements that we need for the macro
				Dim sArguements As Map
				sArguements.Initialize
				sArguements.put("{id}","{id}")
				Dim scommand As String = $"add_class {id} ${sClass}"$
				lstCommands.Add(scommand)
				'remove classes that should not be added
				For Each strOthers As String In allof
					If sClass <> strOthers Then
						Dim scommand As String = $"delete_class {id} ${strOthers}"$
						lstCommands.Add(scommand)
					End If
				Next
				'add to the database
				scommand = jMash.MvFromList(lstCommands,"|")
				Dim argue As String = jMash.MvFromKeys(sArguements," ")
				'save the macro
				Dim macro As Map
				macro.Initialize
				macro.put("macro", className)
				macro.put("arguements",argue)
				macro.put("macrocode",scommand)
				macro.Put("description",sClassName)
				macro.Put("framework",sFramework)
				macro.Put("key", sKey)
				DBUtils.AddRecord(InternalSQL,"Macros",macro)
				jMash.PutObject("macro",macro)
			Next	
			'lets preview one of then
			'show the macros screen
			frmMacros.Show(MainForm)
		End If
	End Select
End Sub

Sub txtJQuery_TextChanged (Old As String, New As String)
	jMash.PutSimple("lastjquery", txtJQuery.Text)
	Dim jq As JQuery
	jq.Initialize(txtJQuery.Text)
	Dim sout As String = jq.transpile
	'process the code to 
	txtTranspile.Text = sout
End Sub