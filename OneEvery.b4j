Sub CLI_PropertyBag
	splitElement.LoadLayout("vCode")
	splitElement.loadlayout("vAppView")
	'hide some buttons
	Dim sw As Long = MainForm.width
	Dim ea As Long = (sw / 2)
	splitElement.SetSizeLimits(1,300,ea)
	
	LoadPropertyBagLayout("vTabElement")
	tabElement.LoadLayout("vProject","Project")
	
	etvProject.ImagesFolder = ImagesFolder
	etvProject.SetPropertyBagWidths(200,300)
	'etvProject.Locked = True
	etvProject.AddLabelProperty("Project Details","projectdetails")
	etvProject.AddTextBoxProperty("App Name", "", "The WebApp Name without spaces", "AppName")
	etvProject.AddTextBoxProperty("Site Title","","The title for the website","SiteTitle")
	etvProject.AddTextBoxProperty("App ID", "com.", "The application id", "AppID")
	etvProject.AddTextBoxProperty("Framework",CLI.Framework,"Framework","framework")
	etvProject.AddTextBoxProperty("Version", "1.00","The version for the app","Version")
	etvProject.AddTextBoxProperty("Author", "","The name of the author of this app","Author")
	etvProject.AddTextBoxProperty("Website", "","The website link of this app","WebSite")
	etvProject.AddTextBoxProperty("Email", "","The contact email address","Email")
	etvProject.AddTextBoxProperty("Copyrights", "","The copyrights details of this app","Copyrights")
	etvProject.AddCheckBoxProperty("UseFontAwesome","1","Use Font Awesome","UseFontAwesome")
	etvProject.AddLabelProperty("Pages","pages")
	etvProject.AddLabelProperty("Total Pages","pagecount")
	etvProject.AddLabelProperty("Active Page","activepage")
	etvProject.AddLabelProperty("Page Components","pagecomponents")
	etvProject.AddLabelProperty("Active Element","activeelement")
	
	etvProject.HandleCrud = False
	etvProject.setloading(False)
	etvProject.SetPropertyBagWidths(150,300)
	etvProject.SetPropertyBag(CLI.AppMap)
	
	PageName = jMash.GetSimple("active_page")
	ActiveElement = jMash.GetSimple("active_element")
	
	Dim totPages As Int = DBUtils.RecordCount(CLI.appsql,"Pages","id")
	Dim totcomp As Int = DBUtils.RecordCountQry(CLI.AppSQL,$"select count(id) from Components where PageName = '${PageName}'"$)
	etvProject.SetProperty("pagecount",totPages)
	etvProject.SetProperty("activepage",PageName)
	etvProject.SetProperty("pagecomponents",totcomp)
	etvProject.SetProperty("activeelement",ActiveElement)
End Sub

