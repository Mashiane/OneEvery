'build the actual webiste page
Sub Page_Build(pgName As String) As ResumableSub
	'read the page from the database
	Dim pgMap As Map = DBUtils.ReadRecord(CLI.appsql,"Pages","pagename",pgName)
	If pgMap.IsInitialized = False Then Return False
	Dim sTitle As String = pgMap.GetDefault("title","")
	Dim sDescription As String = pgMap.GetDefault("description","")
	Dim skeywords As String = pgMap.GetDefault("keywords","")
	'create the htmlpage
	Dim pgSource As HTMLPage
	pgSource.Initialize(CLI.App,pgName)
	pgSource.PageTitle = sTitle
	If CLI.SiteTitle <> "" Then
		pgSource.PageTitle = sTitle & " | " & CLI.SiteTitle
	End If
	pgSource.Description = sDescription
	pgSource.keywords = skeywords
	'add the components for the page
	Dim components As List = DBUtils.ExecuteField1(CLI.appsql,$"select id from Components where PageName = '${pgName}' and Active = 1 and ParentID = 0 order by tabindex"$,"id",False,True)
	Dim rTot As Int = components.Size - 1
	Dim rCnt As Int = 0
	For rCnt = 0 To rTot
		Dim elM As String = components.Get(rCnt)
		Dim source As String = Components_Build(elM)
		pgSource.AddContent(source)
		'Style_Add(pgSource.Style,elID)
		Sleep(1)
	Next
	pgSource.build
	Return True
End Sub

Sub Page_FromElements(rows As List)
	Dim zeroparent As List
	zeroparent.Initialize
	For Each rowM As Map In rows
		Dim rid As String = rowM.GetDefault("id","")
		Dim pid As String = rowM.GetDefault("parentid","")
		If pid = "0" Then zeroparent.Add(rid)
	Next
	'make all ids to mv field
	Dim sids As String = jMash.join(",",zeroparent)
	
	'clear existing preview and source
	AppView.LoadHtml("")
	jMash.CodeAreaSetText(txtHTML,"","1",False)
	'prepare the app for publishing
	App_PreparePublish
	'create an empty page to preview this element
	Dim pgSource As HTMLPage
	pgSource.Initialize(CLI.App,"index")
	pgSource.PageTitle = "Preview"
	If CLI.SiteTitle <> "" Then
		pgSource.PageTitle = "PreView | " & CLI.SiteTitle
	End If
	'process each element
	Dim elmnts As List = DBUtils.ExecuteMaps(InternalSQL,$"select id from Elements where id in (${sids}) order by tabindex"$,Null)
	For Each elM As Map In elmnts
		Dim elID As String = elM.GetDefault("id","")
		Dim source As String = Elements_Build(elID)
		pgSource.AddContent(source)
		Style_Add(pgSource.Style,elID)
		Sleep(1)
	Next
	pgSource.build
	jMash.ShowHTML(CLI.App.wwwpath,"index.html",txtHTML)
	jMash.WebViewLoadFile(CLI.App.wwwPath,"index.html",AppView)
End Sub

'generate a page from components
Sub btnToPage_Click
	Dim rows As List = etvRecords.GetRows
	Page_FromElements(rows)
End Sub

'delete a single element
Sub Element_Delete(ids As String)
	'get the children of these elements
	Dim lstChilds As List = DBUtils.ExecuteField1(InternalSQL,$"select id from elements where parentid in (${ids})"$,"id",False,True)
	Dim kids As String = jMash.join(",",lstChilds)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Elements where parentid in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Attributes where ElementID in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Classes where ElementID in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from CSS where ElementID in (${ids})"$)
	'delete the kids
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Attributes where ElementID in (${kids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Classes where ElementID in (${kids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from CSS where ElementID in (${kids})"$)
End Sub



'delete elements
Sub Elements_Delete(rows As List)
	Dim resp As String = jMash.MsgBoxConfirm(MainForm,"Confirm Delete","Are you sure you want to delete all these record(s)?")
	If resp = "no" Then Return
	Dim ids As String = jMash.Join(",",rows)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Elements where id in (${ids})"$)
	'get the children of these elements
	Dim lstChilds As List = DBUtils.ExecuteField1(InternalSQL,$"select id from elements where parentid in (${ids})"$,"id",False,True)
	Dim kids As String = jMash.join(",",lstChilds)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Elements where parentid in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Attributes where ElementID in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Classes where ElementID in (${ids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from CSS where ElementID in (${ids})"$)
	'delete the kids
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Attributes where ElementID in (${kids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from Classes where ElementID in (${kids})"$)
	DBUtils.ExecuteQuery(InternalSQL,$"delete from CSS where ElementID in (${kids})"$)
End Sub

Sub btnDeleteElements_Click
	Dim rows As List = etvElemAttributes.GetRowsKeys
	If rows.Size - 1 = -1 Then Return
	Elements_Delete(rows)
	ElementAttributes_Grid("")						
